---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import DemoPhone from "../components/DemoPhone.astro";
---

<BaseLayout title="How it works" description="Connect your WhatsApp number, share your prices, and approve the first actions. A 3-step walkthrough and a tap-through demo.">
  <PageHero
    eyebrow="How it works"
    title="Three steps. Then the chats keep flowing."
    lede="The demo below is simulated so you can tap at your own pace. No sound, no autoplay."
  />
  <section class="mx-auto max-w-3xl px-4 py-14 prose-kora">
    <ol>
      <li><strong>Connect your number.</strong> We use WhatsApp Business Platform. Customers do not install anything. You keep the same chats.</li>
      <li><strong>Tell it your prices.</strong> Upload a sheet, forward a broadcast, or photograph a wall list. Confirm a handful of items so it learns your units.</li>
      <li><strong>Approve the first week.</strong> Sit with a named support person. Raise limits only when the log looks right.</li>
    </ol>
  </section>
  <div id="demo">
    <DemoPhone />
  </div>
  <section class="mx-auto max-w-3xl px-4 py-14">
    <p class="eyebrow">With a real person</p>
    <h2 class="mt-3 text-3xl md:text-4xl">See how it fits your shop</h2>
    <p class="mt-2 text-muted">Bring your questions, your price list, and the way you work. <a class="link-accent" href="/demo">Book a 15-minute walkthrough</a> with our team.</p>
    <p class="mt-6">
      <a class="btn btn-primary" href="/pilot">Start free pilot</a>
    </p>
  </section>
</BaseLayout>
