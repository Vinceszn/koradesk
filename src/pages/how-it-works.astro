---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import DemoPhone from "../components/DemoPhone.astro";
---
<BaseLayout title="How Kora works" description="A shared catalogue, stock reservations and one order-to-receipt workflow across sales channels.">
<PageHero eyebrow="The product plan" title="Set up once. Sell in more places." lede="The channels change. The catalogue, stock rules and order record stay together." />
<section class="mx-auto max-w-3xl px-4 py-14 prose-kora"><ol><li><strong>Catalogue and count.</strong> Add products, variants, prices and opening stock.</li><li><strong>Check and reserve.</strong> Confirm the order against available inventory.</li><li><strong>Verify and receipt.</strong> Match the provider-confirmed payment and prepare the PDF.</li><li><strong>Hand over and record.</strong> Dispatch or pickup consumes the reserved stock once.</li></ol><p>The merchant dashboard comes first. A connected storefront and official WhatsApp automation will reuse the same backend.</p></section>
<DemoPhone anchorId="demo" />
</BaseLayout>
