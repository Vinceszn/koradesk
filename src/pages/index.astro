    </div>
    <div class="mx-auto max-w-4xl px-4 pb-16 pt-10 text-center md:pb-20">
      <p class="text-sm text-muted">
        A commerce platform for online sellers, physical shops and businesses doing both.
      </p>
      <p class="mt-4">
        <a
          href="#demo"
          class="link-accent inline-flex min-h-11 items-center gap-2 text-sm font-semibold"
        >
          See how it works
          <span aria-hidden="true">↓</span>
        </a>
      </p>
    </div>
  </section>

  <style is:global>
    .ticker {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(
        to right,
        transparent,
        black 8%,
        black 92%,
        transparent
      );
      mask-image: linear-gradient(
        to right,
        transparent,
        black 8%,
        black 92%,
        transparent
      );
    }
    .ticker-track {
      display: flex;
      width: max-content;
      -webkit-animation: ticker-scroll 48s linear infinite;
      animation-play-state: paused;
      animation: ticker-scroll 48s linear infinite;
      animation-play-state: paused;
    }
    .ticker-track.reverse {
      animation-direction: reverse;
      animation-duration: 60s;
    }
    .original-hero[data-moving="true"] .ticker-track {
      animation-play-state: running;
    }
    @media (hover: hover) {
      .original-hero[data-moving="true"] .ticker:hover .ticker-track {
        animation-play-state: paused;
      }
    }
    @-webkit-keyframes ticker-scroll {
      to {
        -webkit-transform: translateX(-50%);
        transform: translateX(-50%);
      }
    }
    @keyframes ticker-scroll {
      to {
        transform: translateX(-50%);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .ticker-track {
        -webkit-animation: none;
        animation: none;
      }
    }
  </style>

  <DemoPhone anchorId="demo" />

  <section class="border-b border-sand bg-paper">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-8 gap-y-2 px-4 py-5 text-sm text-muted">
      <p class="flex items-center gap-2">
        <CheckIcon tone="plain" />
        One shared catalogue
      </p>
      <p class="flex items-center gap-2">
        <CheckIcon tone="plain" />
        Stock reserved per order
      </p>
      <p class="flex items-center gap-2">
        <CheckIcon tone="plain" />
        Provider-verified payments
      </p>
    </div>
  </section>

  <!-- The daily mess -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <p class="eyebrow">The gaps between channels</p>
    <h2 class="mt-3 text-3xl md:text-4xl">Your business grew. The scattered lists stayed.</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      <article class="rounded-3xl border border-sand bg-white p-6 transition-all duration-200 ease-out hover:rotate-0 hover:border-ink md:-rotate-1">
        <p class="text-xs font-semibold uppercase tracking-widest text-muted">
          WhatsApp + website
        </p>
        <h3 class="mt-2 text-xl">Orders in too many places</h3>
        <p class="mt-2 text-muted">
          A website checkout here. A WhatsApp request there. A counter sale someone forgot to write down.
        </p>
        <p class="mt-4 text-sm font-semibold text-accent">
          The plan: one order record, whatever the channel.
        </p>
      </article>
      <article class="rounded-3xl border border-sand bg-white p-6 transition-all duration-200 ease-out hover:rotate-0 hover:border-ink md:rotate-1">
        <p class="text-xs font-semibold uppercase tracking-widest text-muted">
          Payments + receipts
        </p>
        <h3 class="mt-2 text-xl">Unmatched payments</h3>
        <p class="mt-2 text-muted">
