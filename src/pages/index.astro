        <a href="/pilot" class="btn btn-light">
          Explore the pilot
        </a>
        <a
          href={waLink("Hello, I want to start a Kora Desk pilot.", "home-cta")}
          class="btn btn-on-dark"
        >
          Talk on WhatsApp
        </a>
        <a href="/demo" class="btn btn-on-dark">
          Discuss your workflow
        </a>
      </div>
    </div>
