</BaseLayout>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-creative-hero]")
    .forEach((root) => {
      const button = root.querySelector<HTMLButtonElement>(
        "[data-ticker-pause]",
      )!;
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
      let paused = false;
      let visible = false;
      function paintMotion() {
        root.dataset.moving = String(
          visible && !paused && !reduced.matches && !document.hidden,
        );
        button.hidden = reduced.matches;
        button.setAttribute("aria-pressed", String(paused));
        button.textContent = paused
          ? "Resume moving strips"
          : "Pause moving strips";
      }
      button.addEventListener("click", () => {
        paused = !paused;
        paintMotion();
      });
      // Touch hold pauses both strips together and resumes from position.
      root.querySelectorAll<HTMLElement>(".ticker").forEach((strip) => {
        const release = () => {
          root.dataset.holding = "false";
        };
        strip.addEventListener("pointerdown", () => {
          root.dataset.holding = "true";
        });
        strip.addEventListener("pointerup", release);
        strip.addEventListener("pointercancel", release);
        strip.addEventListener("pointerleave", release);
      });
      const observer = new IntersectionObserver((entries) => {
        visible = entries.some((entry) => entry.isIntersecting);
        paintMotion();
      });
      observer.observe(root);
      reduced.addEventListener("change", paintMotion);
      document.addEventListener("visibilitychange", paintMotion);
      window.addEventListener(
        "pagehide",
        () => {
          observer.disconnect();
          root.dataset.moving = "false";
          root.dataset.holding = "false";
          reduced.removeEventListener("change", paintMotion);
          document.removeEventListener("visibilitychange", paintMotion);
        },
        { once: true },
      );
      paintMotion();
    });
</script>
