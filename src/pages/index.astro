---
import BaseLayout from "../layouts/BaseLayout.astro";
import CheckIcon from "../components/CheckIcon.astro";
import DemoPhone from "../components/DemoPhone.astro";
import ArtButton from "../components/ArtButton.astro";
import CommerceArtwork from "../components/CommerceArtwork.astro";
import Faq from "../components/Faq.astro";
import { agents, faqs, foundingPerks, naira, site, waLink } from "../data/site";
---

<BaseLayout title={site.name} description={site.description}>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqs.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: { "@type": "Answer", text: f.a },
        })),
      })}
    />
  </Fragment>

  <!-- Hero -->
  <section
    class="original-hero overflow-hidden border-b border-sand bg-paper"
    data-creative-hero
  >
    <div class="mx-auto max-w-4xl px-4 pt-16 text-center md:pt-24">
      <p class="inline-flex min-h-11 items-center gap-2 rounded-full border border-sand bg-white px-4 text-sm text-muted">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full rounded-full bg-accent opacity-60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
        </span>
        Building with Nigeria’s next founding merchants
      </p>
      <h1 class="mx-auto mt-6 max-w-3xl text-5xl font-bold leading-[1.04] tracking-tighter md:text-6xl">
        More sales. Less
        <span class="relative inline-block">
          wahala.
          <svg
            class="absolute -left-2 top-1/2 h-3 w-[calc(100%+1rem)] -translate-y-1/2 -rotate-2 md:h-4"
            viewBox="0 0 200 12"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              d="M3 8 C 60 3, 140 3, 197 7"
              stroke="var(--color-clay)"
              stroke-width="5"
              stroke-linecap="round"
              fill="none"
            />
          </svg>
        </span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-muted md:text-xl">
        Your stock, orders and payments—connected across your website, WhatsApp and shop counter. One business, however you sell.
      </p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <ArtButton href="/pilot" label="Build with Kora" />
        <a class="btn btn-ghost" href="#demo">
          Watch a sale happen <span aria-hidden="true">↓</span>
        </a>
      </div>
      <p class="mt-4 text-sm text-muted">
        Product preview · Founding pilot in preparation · No payment taken here
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        <p class="text-xs font-semibold uppercase tracking-widest text-muted">
          Less of this:
        </p>
        <button
          type="button"
          class="motion-switch"
          data-ticker-pause
          aria-pressed="false"
        >
          Pause moving strips
        </button>
      </div>
    </div>
    <p class="sr-only">
      Kora is being built to connect inventory, orders, payments and receipts across a website, WhatsApp and the shop counter.
    </p>
    <div class="mt-4 space-y-3" aria-hidden="true">
      <div class="ticker">
        <div class="ticker-track">
          <div class="flex shrink-0 items-stretch gap-3 pr-3">
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:-rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">
                Copying the same order twice
              </span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">
                Guessing who paid
              </span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:-rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">
                Three different stock lists
              </span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">
                Selling the last item twice
              </span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:-rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">
                Updating prices everywhere
              </span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">
                Hunting for receipts
              </span>
            </div>
          </div>
          <div class="flex shrink-0 items-stretch gap-3 pr-3">
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:-rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">
                Copying the same order twice
              </span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">
                Guessing who paid
              </span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:-rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">
                Three different stock lists
              </span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">
                Selling the last item twice
              </span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:-rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">
                Updating prices everywhere
              </span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">
                Hunting for receipts
              </span>
            </div>
