---
import BaseLayout from "../layouts/BaseLayout.astro";
import DemoPhone from "../components/DemoPhone.astro";
import Faq from "../components/Faq.astro";
import { agents, faqs, foundingPerks, naira, site, waLink } from "../data/site";
---

<BaseLayout title={site.name} description={site.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    })} />
  </Fragment>

  <!-- Hero -->
  <section class="overflow-hidden border-b border-sand bg-paper">
    <div class="mx-auto max-w-4xl px-4 pt-16 text-center md:pt-24">
      <p class="inline-flex min-h-11 items-center gap-2 rounded-full border border-sand bg-white px-4 text-sm text-muted">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
        </span>
        Now onboarding founding shops in Lagos
      </p>
      <h1 class="mx-auto mt-5 max-w-3xl text-5xl font-bold leading-[1.02] tracking-tighter md:text-6xl">
        Close the shop at <span class="text-accent">6pm</span>, not 10pm.
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-muted md:text-xl">
        Kora Desk runs your back office inside WhatsApp — orders, payments, stock, and books — while you approve anything that moves money.
      </p>
      <div class="mt-8 flex justify-center">
        <a href="/pilot" class="btn btn-primary md:min-h-14 md:px-8 md:text-base">Start free pilot</a>
      </div>
      <ul class="mt-6 flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm text-muted">
        <li class="flex items-center gap-2"><span class="font-bold text-leaf" aria-hidden="true">✓</span>14-day free pilot</li>
        <li class="flex items-center gap-2"><span class="font-bold text-leaf" aria-hidden="true">✓</span>Live WhatsApp number</li>
        <li class="flex items-center gap-2"><span class="font-bold text-leaf" aria-hidden="true">✓</span>No card required</li>
      </ul>
      <p class="mt-12 text-sm text-muted">Your WhatsApp at 9pm — every night:</p>
    </div>
    <p class="sr-only">A scrolling strip of typical evening messages: voice notes, bank alerts, photos of lists, and confirmations.</p>
    <div class="mt-4 space-y-3" aria-hidden="true">
      <div class="ticker">
        <div class="ticker-track">
          <div class="flex shrink-0 items-stretch gap-3 pr-3">
            <div class="w-60 shrink-0 rounded-xl border border-sand bg-bubble p-3 text-left sm:w-64">
              <p class="text-xs font-semibold text-muted">VOICE NOTE · 0:12</p>
              <div class="mt-2 flex items-center gap-1" aria-hidden="true">
                <span class="w-[3px] rounded-full bg-sand" style="height:8px"></span><span class="w-[3px] rounded-full bg-sand" style="height:14px"></span><span class="w-[3px] rounded-full bg-sand" style="height:10px"></span><span class="w-[3px] rounded-full bg-sand" style="height:16px"></span><span class="w-[3px] rounded-full bg-sand" style="height:12px"></span><span class="w-[3px] rounded-full bg-sand" style="height:9px"></span><span class="w-[3px] rounded-full bg-sand" style="height:15px"></span>
              </div>
              <p class="mt-2 text-sm text-ink">“3 bags rice, 2 cartons indomie, 1 gallon oil…”</p>
            </div>
            <div class="w-60 shrink-0 rounded-xl border border-sand bg-bubble p-3 text-left sm:w-64">
              <p class="text-xs font-semibold text-muted">PHOTO · 8:52 PM</p>
              <p class="mt-2 rounded-lg border border-dashed border-sand bg-surface px-3 py-4 text-center text-sm text-muted">IMG_2041.jpg</p>
              <p class="mt-2 text-sm text-ink">Handwritten price list, page 2 of 3</p>
            </div>
            <div class="w-60 shrink-0 rounded-xl border border-sand bg-bubble p-3 text-left sm:w-64">
              <p class="text-xs font-semibold text-muted">TEXT · 9:03 PM</p>
              <p class="mt-2 text-sm text-ink">Aunty, send 2 gallons oil tomorrow morning. Urgent!</p>
            </div>
            <div class="w-60 shrink-0 rounded-xl border border-sand bg-bubble p-3 text-left sm:w-64">
              <p class="text-xs font-semibold text-muted">BANK ALERT · 9:11 PM</p>
              <p class="mt-2 text-sm text-ink">Credit ₦168,000 — no name attached. Whose is this?</p>
            </div>
            <div class="w-60 shrink-0 rounded-xl border border-sand bg-bubble p-3 text-left sm:w-64">
              <p class="text-xs font-semibold text-muted">SCREENSHOT · 9:14 PM</p>
              <p class="mt-2 rounded-lg border border-dashed border-sand bg-surface px-3 py-4 text-center text-sm text-muted">Screenshot_21-04.png</p>
              <p class="mt-2 text-sm text-ink">“I have sent it ma” — which invoice?</p>
            </div>
          </div>
          <div class="flex shrink-0 items-stretch gap-3 pr-3">
            <div class="w-60 shrink-0 rounded-xl border border-sand bg-bubble p-3 text-left sm:w-64">
              <p class="text-xs font-semibold text-muted">VOICE NOTE · 0:12</p>
              <div class="mt-2 flex items-center gap-1" aria-hidden="true">
                <span class="w-[3px] rounded-full bg-sand" style="height:8px"></span><span class="w-[3px] rounded-full bg-sand" style="height:14px"></span><span class="w-[3px] rounded-full bg-sand" style="height:10px"></span><span class="w-[3px] rounded-full bg-sand" style="height:16px"></span><span class="w-[3px] rounded-full bg-sand" style="height:12px"></span><span class="w-[3px] rounded-full bg-sand" style="height:9px"></span><span class="w-[3px] rounded-full bg-sand" style="height:15px"></span>
              </div>
              <p class="mt-2 text-sm text-ink">“3 bags rice, 2 cartons indomie, 1 gallon oil…”</p>
            </div>
            <div class="w-60 shrink-0 rounded-xl border border-sand bg-bubble p-3 text-left sm:w-64">
              <p class="text-xs font-semibold text-muted">PHOTO · 8:52 PM</p>
              <p class="mt-2 rounded-lg border border-dashed border-sand bg-surface px-3 py-4 text-center text-sm text-muted">IMG_2041.jpg</p>
              <p class="mt-2 text-sm text-ink">Handwritten price list, page 2 of 3</p>
            </div>
            <div class="w-60 shrink-0 rounded-xl border border-sand bg-bubble p-3 text-left sm:w-64">
              <p class="text-xs font-semibold text-muted">TEXT · 9:03 PM</p>
              <p class="mt-2 text-sm text-ink">Aunty, send 2 gallons oil tomorrow morning. Urgent!</p>
            </div>
            <div class="w-60 shrink-0 rounded-xl border border-sand bg-bubble p-3 text-left sm:w-64">
              <p class="text-xs font-semibold text-muted">BANK ALERT · 9:11 PM</p>
              <p class="mt-2 text-sm text-ink">Credit ₦168,000 — no name attached. Whose is this?</p>
            </div>
            <div class="w-60 shrink-0 rounded-xl border border-sand bg-bubble p-3 text-left sm:w-64">
              <p class="text-xs font-semibold text-muted">SCREENSHOT · 9:14 PM</p>
              <p class="mt-2 rounded-lg border border-dashed border-sand bg-surface px-3 py-4 text-center text-sm text-muted">Screenshot_21-04.png</p>
              <p class="mt-2 text-sm text-ink">“I have sent it ma” — which invoice?</p>
            </div>
          </div>
        </div>
      </div>
      <div class="ticker">
        <div class="ticker-track reverse">
          <div class="flex shrink-0 items-stretch gap-3 pr-3">
            <div class="w-60 shrink-0 rounded-xl border border-sand bg-bubble-out p-3 text-left sm:w-64">
              <p class="text-xs font-semibold text-accent">ORDER DRAFTED</p>
              <p class="mt-2 text-sm text-ink">3 × rice, 2 × Indomie, 1 × oil — <strong>₦233,500</strong>. Reply YES to confirm.</p>
            </div>
            <div class="w-60 shrink-0 rounded-xl border border-sand bg-bubble-out p-3 text-left sm:w-64">
              <p class="text-xs font-semibold text-accent">PAYMENT MATCHED</p>
              <p class="mt-2 text-sm text-ink"><strong>₦168,000</strong> matched to Invoice KD-1842. Receipt sent.</p>
            </div>
            <div class="w-60 shrink-0 rounded-xl border border-sand bg-bubble-out p-3 text-left sm:w-64">
              <p class="text-xs font-semibold text-warning">STOCK FLAG</p>
              <p class="mt-2 text-sm text-ink">Indomie running low — 4 cartons left. Reorder draft ready.</p>
            </div>
            <div class="w-60 shrink-0 rounded-xl border border-sand bg-bubble-out p-3 text-left sm:w-64">
              <p class="text-xs font-semibold text-accent">INVOICE SENT</p>
              <p class="mt-2 text-sm text-ink">Invoice KD-1842.pdf delivered. Transfer details attached.</p>
            </div>
            <div class="w-60 shrink-0 rounded-xl border border-sand bg-bubble-out p-3 text-left sm:w-64">
              <p class="text-xs font-semibold text-accent">DELIVERY BOOKED</p>
              <p class="mt-2 text-sm text-ink">Tomorrow 7–9am. Customer confirmed with YES.</p>
            </div>
          </div>
          <div class="flex shrink-0 items-stretch gap-3 pr-3">
            <div class="w-60 shrink-0 rounded-xl border border-sand bg-bubble-out p-3 text-left sm:w-64">
              <p class="text-xs font-semibold text-accent">ORDER DRAFTED</p>
              <p class="mt-2 text-sm text-ink">3 × rice, 2 × Indomie, 1 × oil — <strong>₦233,500</strong>. Reply YES to confirm.</p>
            </div>
            <div class="w-60 shrink-0 rounded-xl border border-sand bg-bubble-out p-3 text-left sm:w-64">
              <p class="text-xs font-semibold text-accent">PAYMENT MATCHED</p>
              <p class="mt-2 text-sm text-ink"><strong>₦168,000</strong> matched to Invoice KD-1842. Receipt sent.</p>
            </div>
            <div class="w-60 shrink-0 rounded-xl border border-sand bg-bubble-out p-3 text-left sm:w-64">
              <p class="text-xs font-semibold text-warning">STOCK FLAG</p>
              <p class="mt-2 text-sm text-ink">Indomie running low — 4 cartons left. Reorder draft ready.</p>
            </div>
            <div class="w-60 shrink-0 rounded-xl border border-sand bg-bubble-out p-3 text-left sm:w-64">
              <p class="text-xs font-semibold text-accent">INVOICE SENT</p>
              <p class="mt-2 text-sm text-ink">Invoice KD-1842.pdf delivered. Transfer details attached.</p>
            </div>
            <div class="w-60 shrink-0 rounded-xl border border-sand bg-bubble-out p-3 text-left sm:w-64">
              <p class="text-xs font-semibold text-accent">DELIVERY BOOKED</p>
              <p class="mt-2 text-sm text-ink">Tomorrow 7–9am. Customer confirmed with YES.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="mx-auto max-w-4xl px-4 pb-16 pt-10 text-center md:pb-20">
      <p class="mx-auto max-w-2xl text-lg md:text-xl"><strong class="font-bold tracking-tight">By morning, it is orders, matched payments, and clean books.</strong> <span class="text-muted">You just approve.</span></p>
      <p class="mt-4 text-sm text-muted">Voice and text in English, Pidgin, Yoruba, Hausa, Igbo, and Swahili · Guided 14-day pilot · No card</p>
    </div>
  </section>

<style is:global>
  .ticker {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }
  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker-scroll 48s linear infinite;
  }
  .ticker-track.reverse {
    animation-direction: reverse;
    animation-duration: 60s;
  }
  .ticker:hover .ticker-track {
    animation-play-state: paused;
  }
  @keyframes ticker-scroll {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; }
  }
</style>

  <DemoPhone />

  <!-- The daily mess -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-3xl md:text-4xl">The daily mess, in three lines</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      <article class="rounded-3xl border border-sand bg-white p-6">
        <h3 class="text-xl">Missed orders</h3>
        <p class="mt-2 text-muted">Voice notes pile up while you serve the person in front of you.</p>
        <p class="mt-4 text-sm font-semibold text-accent">Fix: the Orders agent drafts every request as it arrives.</p>
      </article>
      <article class="rounded-3xl border border-sand bg-white p-6">
        <h3 class="text-xl">Unmatched payments</h3>
        <p class="mt-2 text-muted">Alerts and screenshots sit in chat. You guess who paid.</p>
        <p class="mt-4 text-sm font-semibold text-accent">Fix: Payments matches transfers to open invoices.</p>
      </article>
      <article class="rounded-3xl border border-sand bg-white p-6">
        <h3 class="text-xl">Stock that never adds up</h3>
        <p class="mt-2 text-muted">The shelf and the book disagree by Friday.</p>
        <p class="mt-4 text-sm font-semibold text-accent">Fix: Stock updates from sales and deliveries, then flags odd gaps.</p>
      </article>
    </div>
  </section>

  <!-- Four agents -->
  <section class="border-y border-sand bg-surface py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-3xl md:text-4xl">Four agents. One WhatsApp number.</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          agents.map((agent) => (
            <a href={agent.href} class="rounded-3xl border border-sand bg-white p-6 text-ink no-underline transition-all duration-200 ease-out hover:border-ink active:scale-[0.99]">
              <h3 class="text-2xl">{agent.name}</h3>
              <p class="mt-2 text-muted">{agent.job}</p>
              <p class="mt-4 text-sm text-muted">{agent.checkpoint}</p>
              <span class="mt-4 inline-block text-sm font-semibold text-accent">Read more →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-3xl md:text-4xl">How it works</h2>
    <ol class="mt-8 grid gap-4 md:grid-cols-3">
      <li class="rounded-3xl border border-sand bg-white p-6">
        <p class="text-sm font-semibold tracking-widest text-accent">01</p>
        <h3 class="mt-3 text-lg font-semibold">Connect your number</h3>
        <p class="mt-2 text-muted">We link the WhatsApp line customers already use. No app for them to install.</p>
      </li>
      <li class="rounded-3xl border border-sand bg-white p-6">
        <p class="text-sm font-semibold tracking-widest text-accent">02</p>
        <h3 class="mt-3 text-lg font-semibold">Tell it your prices</h3>
        <p class="mt-2 text-muted">Share a price list, even a photo of a handwritten sheet. You can correct it any time.</p>
      </li>
      <li class="rounded-3xl border border-sand bg-white p-6">
        <p class="text-sm font-semibold tracking-widest text-accent">03</p>
        <h3 class="mt-3 text-lg font-semibold">Approve the first few actions</h3>
        <p class="mt-2 text-muted">Watch the log. Raise or lower limits. Undo for 24 hours.</p>
      </li>
    </ol>
    <p class="mt-6"><a class="link-accent font-semibold" href="/how-it-works">See the full walkthrough</a></p>
  </section>

  <!-- Founding pilot -->
  <section class="border-y border-sand bg-surface py-16">
    <div class="mx-auto max-w-6xl px-4">
      <p class="eyebrow">Early access</p>
      <h2 class="mt-3 text-3xl md:text-4xl">Built with founding shops in Lagos</h2>
      <p class="mt-3 max-w-2xl text-muted">
        Kora Desk is live in a guided pilot. We onboard a few shops each week, sit with you through the first 14 days, and shape the product around what breaks.
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          foundingPerks.map((perk) => (
            <article class="rounded-3xl border border-sand bg-white p-6">
              <h3 class="text-xl">{perk.title}</h3>
              <p class="mt-2 text-muted">{perk.text}</p>
            </article>
          ))
        }
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/pilot" class="btn btn-primary">Join the pilot</a>
        <a href="/customers" class="btn btn-ghost">How the 14 days run</a>
      </div>
    </div>
  </section>

  <!-- Trust band -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="rounded-3xl bg-ink px-6 py-10 text-white md:px-10 md:py-12">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent-bright">Trust</p>
      <h2 class="mt-3 max-w-2xl text-3xl">You approve money moves. Everything is logged. You can undo.</h2>
      <p class="mt-4 max-w-2xl text-sand">
        The agent never pays a supplier, never issues a refund, and never writes off a debt without you. Full audit trail. 24-hour undo window.
      </p>
      <a href="/trust" class="btn btn-on-dark mt-6">Trust &amp; security</a>
    </div>
  </section>

  <!-- Pricing teaser -->
  <section class="mx-auto max-w-6xl px-4 pb-16">
    <h2 class="text-3xl">Simple prices in naira</h2>
    <p class="mt-2 text-muted">Starter from {naira(15000)} / month. Growth {naira(45000)}. 14-day pilot free.</p>
    <a class="btn btn-ghost mt-5" href="/pricing">See full pricing</a>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-4 pb-16">
    <h2 class="text-3xl">Questions owners ask</h2>
    <div class="mt-6">
      <Faq items={faqs} />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-ink py-16 text-white">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <h2 class="text-4xl">Ready in two minutes</h2>
      <p class="mt-3 text-sand">Tell us your name, your shop, and your WhatsApp number. We set up the pilot with you.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/pilot" class="btn btn-light">Start free pilot</a>
        <a href={waLink("Hello, I want to start a Kora Desk pilot.", "home-cta")} class="btn btn-on-dark">Talk on WhatsApp</a>
        <a href="/demo" class="btn btn-on-dark">Book a 15-minute demo</a>
      </div>
    </div>
  </section>
</BaseLayout>
