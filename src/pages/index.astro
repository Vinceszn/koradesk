      </article>
      <article class="rounded-3xl border border-sand bg-white p-6 transition-all duration-200 ease-out hover:rotate-0 hover:border-ink md:-rotate-1">
        <p class="text-xs font-semibold uppercase tracking-widest text-muted">
          Shelf + storefront
        </p>
        <h3 class="mt-2 text-xl">Stock that never adds up</h3>
        <p class="mt-2 text-muted">
          Your website says available. Your staff just sold the last one. Your customer is already paying.
        </p>
        <p class="mt-4 text-sm font-semibold text-accent">
          The plan: a shared stock record with order reservations.
        </p>
      </article>
    </div>
  </section>

  <!-- Four agents -->
  <section class="border-y border-sand bg-surface py-16">
    <div class="mx-auto max-w-6xl px-4">
      <p class="eyebrow">One commerce core</p>
      <h2 class="mt-3 text-3xl md:text-4xl">
        Everything a sale needs, connected.
      </h2>
      <div class="brand-functions mt-8 grid gap-4 sm:grid-cols-2">
        {agents.map((agent, i) => (
          <a
            href={agent.href}
            class:list={[
              `brand-function brand-${agent.tone} rounded-3xl p-6 text-ink no-underline transition-all duration-200 ease-out hover:-translate-y-1 hover:shadow-soft active:scale-[0.99]`,
              i % 2 === 1 && "sm:mt-10",
            ]}
          >
            <img
              class="brand-function-art"
              src={agent.art}
              alt=""
              width="88"
              height="88"
              loading="lazy"
              decoding="async"
            />
