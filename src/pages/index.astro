---
import BaseLayout from "../layouts/BaseLayout.astro";
import AgentSymbol from "../components/AgentSymbol.astro";
import HeroDesk from "../components/HeroDesk.astro";
import Faq from "../components/Faq.astro";
import { agents, faqs, site, waLink } from "../data/site";
const outcomes = [
  {
    title: "Every order, accounted for.",
    text: "Turn voice notes, messages, and handwritten lists into a clear order draft.",
    agent: "orders",
    before: "Voice notes piling up",
    after: "An order, ready to check",
  },
  {
    title: "Know exactly who paid.",
    text: "Match bank alerts to invoices and keep outstanding payments in view.",
    agent: "payments",
    before: "“I sent it. Check your alert.”",
    after: "A payment, matched to its invoice",
  },
  {
    title: "Close with a clearer picture.",
    text: "Keep stock and sales records together, with a summary your accountant can review.",
    agent: "books",
    before: "Another evening with the ledger",
    after: "Your day, already summarised",
  },
];
---

<BaseLayout title={site.name} description={site.description}>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqs.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: { "@type": "Answer", text: f.a },
        })),
      })}
    />
  </Fragment>
  <section class="home-hero">
    <div class="kora-container hero-grid">
      <div class="hero-copy">
        <p class="availability">
          <span aria-hidden="true"></span>Founding shop pilots · Lagos
        </p>
        <h1>
          Your shop.
          <br />
          Your people.
          <br />
          <span>Less paperwork.</span>
        </h1>
        <p class="hero-lede">
          Orders, payments, stock, and books.
          <br class="desktop-break" /> Handled from the WhatsApp you already
          use.
        </p>
        <div class="hero-actions">
          <a class="btn btn-accent" href="/pilot">
            Start your free pilot <span aria-hidden="true">↗</span>
          </a>
          <a class="hero-demo-link" href="#demo">
            Try the sample <span aria-hidden="true">↓</span>
          </a>
        </div>
        <p class="hero-fineprint">
          14 days free. No card. A real person helps you set up.
        </p>
        <div class="hero-assurance">
          <svg
            width="20"
            height="22"
            viewBox="0 0 24 26"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <path d="M12 2 3 6v7c0 6 9 11 9 11s9-5 9-11V6l-9-4Z" />
            <path d="m8 12 3 3 5-6" />
          </svg>
          <p>
            The agents do the admin.
            <br />
            <strong>You approve anything that moves money.</strong>
          </p>
        </div>
      </div>
      <div class="hero-workbench" id="demo">
        <p class="workbench-label">
          <span>FROM CHAT TO SORTED</span>
          <span>01 / A WORKING EXAMPLE</span>
        </p>
        <HeroDesk />
        <p class="workbench-footnote">
          Try all four agents. Sample data only; nothing is sent.
        </p>
      </div>
    </div>
  </section>
  <div class="promise-strip">
    <div class="kora-container">
      <p>Built for the way your shop runs.</p>
      <span>No new app for customers</span>
      <span>One WhatsApp number</span>
      <span>Human onboarding included</span>
    </div>
  </div>
  <section class="kora-container home-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">A lighter working day</p>
        <h2>
          The chats keep coming.
          <br />
          The admin doesn’t have to.
        </h2>
      </div>
      <p>
        Keep serving the person in front of you. Give the copying, matching, and
        counting to Kora.
      </p>
    </div>
    <div class="outcome-grid">
      {outcomes.map((item, i) => (
        <article class="outcome">
          <div class="outcome-number">
            <span>0{i + 1}</span>
            <AgentSymbol agent={item.agent} />
          </div>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <div class="outcome-shift">
            <span>{item.before}</span>
            <svg
              width="16"
              height="22"
              viewBox="0 0 16 22"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M8 1v17m-4-4 4 4 4-4" />
            </svg>
            <strong>{item.after}</strong>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="agent-section">
    <div class="kora-container home-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Meet your back office</p>
          <h2>
            Four specialists.
            <br />
            One familiar chat.
          </h2>
        </div>
        <a class="text-link" href="/product">
          Explore the agents <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="agent-directory">
        {agents.map((agent, i) => (
          <a href={agent.href} class="agent-row">
            <span class="agent-row-number">0{i + 1}</span>
            <span class={`agent-symbol agent-${agent.slug}`}>
              <AgentSymbol agent={agent.slug} size={27} />
            </span>
            <h3>{agent.name}</h3>
            <div class="agent-row-detail">
              <p>{agent.job}</p>
              <span>{agent.checkpoint}</span>
            </div>
            <span class="agent-row-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="kora-container home-section setup-section">
    <div>
      <p class="eyebrow">A person gets you started</p>
      <h2>
        Your number.
        <br />
        Your prices.
        <br />
        <span class="text-accent">We’ll do the setup.</span>
      </h2>
      <p class="setup-intro">
        A guided 14-day pilot, built around your shop. We stay close while you
        see what works.
      </p>
      <a href="/customers" class="text-link">
        See how the pilot runs <span aria-hidden="true">↗</span>
      </a>
    </div>
    <ol class="setup-steps">
      <li>
        <span>01</span>
        <div>
          <h3>Connect your WhatsApp</h3>
          <p>We help link the number your customers already know.</p>
        </div>
      </li>
      <li>
        <span>02</span>
        <div>
          <h3>Share your price list</h3>
          <p>
            A spreadsheet, a message, even a photo of your handwritten list.
          </p>
        </div>
      </li>
      <li>
        <span>03</span>
        <div>
          <h3>Check. Approve. Get on with your day.</h3>
          <p>
            Review the first drafts with your setup person. You set the approval
            limits.
          </p>
        </div>
      </li>
    </ol>
  </section>
  <section class="control-section">
    <div class="kora-container control-grid">
      <div>
        <p class="eyebrow eyebrow-bright">Your business. Your say.</p>
        <h2>
          A helping hand.
          <br />
          You keep the keys.
        </h2>
        <p>
          Refunds, write-offs, and supplier payments need your approval. Every
          action has a log you can review.
        </p>
        <a class="btn btn-on-dark" href="/trust">
          How we keep you in control <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="approval-example">
        <div>
          <span class="approval-icon" aria-hidden="true">
            ✓
          </span>
          <span>Owner approval required</span>
        </div>
        <h3>
          Nothing moves money
          <br />
          without your say-so.
        </h3>
        <ul>
          <li>
            <span>Approval limits</span>
            <strong>Set by you</strong>
          </li>
          <li>
            <span>Action history</span>
            <strong>Always reviewable</strong>
          </li>
          <li>
            <span>Most actions</span>
            <strong>24-hour undo window</strong>
          </li>
        </ul>
        <p>
          External messages and completed bank transfers cannot be recalled.
        </p>
      </div>
    </div>
  </section>
  <section class="kora-container home-section home-pricing">
    <div>
      <p class="eyebrow">Straightforward naira pricing</p>
      <h2>
        Start small.
        <br />
        Find your rhythm.
      </h2>
      <p>
        Your first 14 days are free. Choose a plan after you’ve tried it with
        your shop.
      </p>
      <a class="text-link" href="/pricing">
        Compare plans <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="price-preview">
      <div>
        <span>Starter</span>
        <strong>
          ₦15,000<small> / month</small>
        </strong>
        <p>Orders + Payments · 1 WhatsApp number</p>
      </div>
      <div>
        <span>Growth</span>
        <strong>
          ₦45,000<small> / month</small>
        </strong>
        <p>All four agents · 3 WhatsApp numbers</p>
      </div>
    </div>
  </section>
  <section class="kora-container home-section home-faq">
    <div>
      <p class="eyebrow">Before you start</p>
      <h2>Good questions.</h2>
      <p>
        Still have one?{" "}
        <a
          class="link-accent"
          href={waLink("Hello, I have a question about Kora Desk.", "home-faq")}
        >
          Talk to a person.
        </a>
      </p>
    </div>
    <div>
      <Faq items={faqs} />
    </div>
  </section>
  <section class="closing-section">
    <div class="kora-container">
      <p class="eyebrow">Let’s clear your desk</p>
      <h2>
        More shop.
        <br />
        <span>Less after-hours.</span>
      </h2>
      <p>
        Start with your name, your shop, and your WhatsApp number.
        <br />
        We’ll take the setup from there.
      </p>
      <div class="hero-actions">
        <a href="/pilot" class="btn btn-accent">
          Start your free pilot <span aria-hidden="true">↗</span>
        </a>
        <a href="/demo" class="text-link">
          Talk it through first <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="hero-fineprint">
        14 days free · No card required · Human setup
      </p>
    </div>
  </section>
</BaseLayout>
