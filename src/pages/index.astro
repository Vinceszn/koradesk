---
import BaseLayout from "../layouts/BaseLayout.astro";
import AgentIcon from "../components/AgentIcon.astro";
import CheckIcon from "../components/CheckIcon.astro";
import DemoPhone from "../components/DemoPhone.astro";
import Faq from "../components/Faq.astro";
import { agents, faqs, foundingPerks, naira, site, waLink } from "../data/site";
---

<BaseLayout title={site.name} description={site.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    })} />
  </Fragment>

  <!-- Hero -->
  <section class="overflow-hidden border-b border-sand bg-paper">
    <div class="mx-auto max-w-4xl px-4 pt-16 text-center md:pt-24">
      <p class="inline-flex min-h-11 items-center gap-2 rounded-full border border-sand bg-white px-4 text-sm text-muted">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
        </span>
        Now onboarding founding shops in Lagos
      </p>
      <h1 class="mx-auto mt-6 max-w-3xl text-5xl font-bold leading-[1.04] tracking-tighter md:text-6xl">
        You didn&rsquo;t start a shop to do
        <span class="relative inline-block">
          paperwork.
          <svg class="absolute -left-2 top-1/2 h-3 w-[calc(100%+1rem)] -translate-y-1/2 -rotate-2 md:h-4" viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true">
            <path d="M3 8 C 60 3, 140 3, 197 7" stroke="var(--color-clay)" stroke-width="5" stroke-linecap="round" fill="none" />
          </svg>
        </span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-muted md:text-xl">
        Kora Desk does the copying, matching, and counting inside WhatsApp. You approve anything that moves money.
      </p>
      <p class="mt-4 text-sm text-muted">Free 14-day pilot · No card · Human onboarding</p>
      <p class="mt-12 text-xs font-semibold uppercase tracking-widest text-muted">Crossed out, every evening:</p>
    </div>
    <p class="sr-only">A scrolling strip of admin chores being crossed out, and the evenings handed back.</p>
    <div class="mt-4 space-y-3" aria-hidden="true">
      <div class="ticker">
        <div class="ticker-track">
          <div class="flex shrink-0 items-stretch gap-3 pr-3">
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:-rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">Copying voice notes into ledgers</span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">Hunting unmatched transfers</span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:-rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">Friday stock counts</span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">Chasing &ldquo;who paid?&rdquo;</span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:-rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">Rewriting price lists</span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">Month-end cleanup</span>
            </div>
          </div>
          <div class="flex shrink-0 items-stretch gap-3 pr-3">
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:-rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">Copying voice notes into ledgers</span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">Hunting unmatched transfers</span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:-rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">Friday stock counts</span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">Chasing &ldquo;who paid?&rdquo;</span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:-rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">Rewriting price lists</span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-white p-3 pr-5 text-left md:rotate-1">
              <CheckIcon tone="ink" />
              <span class="text-sm text-muted line-through decoration-clay/70 decoration-2">Month-end cleanup</span>
            </div>
          </div>
        </div>
      </div>
      <p class="text-center text-xs font-semibold uppercase tracking-widest text-accent">Handed back:</p>
      <div class="ticker">
        <div class="ticker-track reverse">
          <div class="flex shrink-0 items-stretch gap-3 pr-3">
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-bubble-out p-3 pr-5 text-left md:rotate-1">
              <CheckIcon tone="accent" />
              <span class="text-sm font-semibold text-ink">Serve the person in front of you</span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-bubble-out p-3 pr-5 text-left md:-rotate-1">
              <CheckIcon tone="accent" />
              <span class="text-sm font-semibold text-ink">Close the shop at 6pm</span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-bubble-out p-3 pr-5 text-left md:rotate-1">
              <CheckIcon tone="accent" />
              <span class="text-sm font-semibold text-ink">Count cash, not chats</span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-bubble-out p-3 pr-5 text-left md:-rotate-1">
              <CheckIcon tone="accent" />
              <span class="text-sm font-semibold text-ink">One WhatsApp number for everything</span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-bubble-out p-3 pr-5 text-left md:rotate-1">
              <CheckIcon tone="accent" />
              <span class="text-sm font-semibold text-ink">Books that balance themselves</span>
            </div>
          </div>
          <div class="flex shrink-0 items-stretch gap-3 pr-3">
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-bubble-out p-3 pr-5 text-left md:rotate-1">
              <CheckIcon tone="accent" />
              <span class="text-sm font-semibold text-ink">Serve the person in front of you</span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-bubble-out p-3 pr-5 text-left md:-rotate-1">
              <CheckIcon tone="accent" />
              <span class="text-sm font-semibold text-ink">Close the shop at 6pm</span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-bubble-out p-3 pr-5 text-left md:rotate-1">
              <CheckIcon tone="accent" />
              <span class="text-sm font-semibold text-ink">Count cash, not chats</span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-bubble-out p-3 pr-5 text-left md:-rotate-1">
              <CheckIcon tone="accent" />
              <span class="text-sm font-semibold text-ink">One WhatsApp number for everything</span>
            </div>
            <div class="flex w-max max-w-[85vw] shrink-0 items-center gap-3 rounded-full border border-sand bg-bubble-out p-3 pr-5 text-left md:rotate-1">
              <CheckIcon tone="accent" />
              <span class="text-sm font-semibold text-ink">Books that balance themselves</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="mx-auto max-w-4xl px-4 pb-16 pt-10 text-center md:pb-20">
      <p class="text-sm text-muted">No stats yet — 14-day pilots, humans included.</p>
      <p class="mt-4">
        <a href="#demo" class="link-accent inline-flex min-h-11 items-center gap-2 text-sm font-semibold">
          See how it works
          <span aria-hidden="true">↓</span>
        </a>
      </p>
    </div>
  </section>

<style is:global>
  .ticker {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }
  .ticker-track {
    display: flex;
    width: max-content;
    -webkit-animation: ticker-scroll 48s linear infinite;
    animation: ticker-scroll 48s linear infinite;
  }
  .ticker-track.reverse {
    animation-direction: reverse;
    animation-duration: 60s;
  }
  @media (hover: hover) {
    .ticker:hover .ticker-track {
      animation-play-state: paused;
    }
  }
  @-webkit-keyframes ticker-scroll {
    to { -webkit-transform: translateX(-50%); transform: translateX(-50%); }
  }
  @keyframes ticker-scroll {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track { -webkit-animation: none; animation: none; }
  }
</style>

  <DemoPhone anchorId="demo" />

  <section class="border-b border-sand bg-paper">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-8 gap-y-2 px-4 py-5 text-sm text-muted">
      <p class="flex items-center gap-2"><CheckIcon tone="plain" />No app to install</p>
      <p class="flex items-center gap-2"><CheckIcon tone="plain" />Works on slow networks</p>
      <p class="flex items-center gap-2"><CheckIcon tone="plain" />You approve money moves</p>
    </div>
  </section>

  <!-- The daily mess -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <p class="eyebrow">The 9pm pile-up</p>
    <h2 class="mt-3 text-3xl md:text-4xl">The daily wahala, in three lines</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      <article class="rounded-3xl border border-sand bg-white p-6 transition-all duration-200 ease-out hover:rotate-0 hover:border-ink md:-rotate-1">
        <p class="text-xs font-semibold uppercase tracking-widest text-muted">Surulere · 9:14 PM</p>
        <h3 class="mt-2 text-xl">Missed orders</h3>
        <p class="mt-2 text-muted">Voice notes pile up while you serve the person in front of you.</p>
        <p class="mt-4 text-sm font-semibold text-accent">Fix: the Orders agent drafts every request as it arrives.</p>
      </article>
      <article class="rounded-3xl border border-sand bg-white p-6 transition-all duration-200 ease-out hover:rotate-0 hover:border-ink md:rotate-1">
        <p class="text-xs font-semibold uppercase tracking-widest text-muted">Agege · 9:41 PM</p>
        <h3 class="mt-2 text-xl">Unmatched payments</h3>
        <p class="mt-2 text-muted">Alerts and screenshots sit in chat. You guess who paid.</p>
        <p class="mt-4 text-sm font-semibold text-accent">Fix: Payments matches transfers to open invoices.</p>
      </article>
      <article class="rounded-3xl border border-sand bg-white p-6 transition-all duration-200 ease-out hover:rotate-0 hover:border-ink md:-rotate-1">
        <p class="text-xs font-semibold uppercase tracking-widest text-muted">Yaba · Friday 6:02 PM</p>
        <h3 class="mt-2 text-xl">Stock that never adds up</h3>
        <p class="mt-2 text-muted">The shelf and the book disagree by Friday.</p>
        <p class="mt-4 text-sm font-semibold text-accent">Fix: Stock updates from sales and deliveries, then flags odd gaps.</p>
      </article>
    </div>
  </section>

  <!-- Four agents -->
  <section class="border-y border-sand bg-surface py-16">
    <div class="mx-auto max-w-6xl px-4">
      <p class="eyebrow">Four specialists, zero new apps</p>
      <h2 class="mt-3 text-3xl md:text-4xl">Four agents. One WhatsApp number.</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          agents.map((agent, i) => (
            <a
              href={agent.href}
              class:list={[
                "rounded-3xl border border-sand bg-white p-6 text-ink no-underline transition-all duration-200 ease-out hover:-translate-y-1 hover:border-ink hover:shadow-soft active:scale-[0.99]",
                i % 2 === 1 && "sm:mt-10",
              ]}
            >
              <div class="mb-4"><AgentIcon slug={agent.slug} /></div>
              <h3 class="text-2xl">{agent.name}</h3>
              <p class="mt-2 text-muted">{agent.job}</p>
              <p class="mt-4 text-sm text-muted">{agent.checkpoint}</p>
              <span class="mt-4 inline-block text-sm font-semibold text-accent">Read more →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-3xl md:text-4xl">How it works</h2>
    <p class="mt-3 max-w-2xl text-muted">No onboarding webinar. No 40-page manual.</p>
    <ol class="mt-8 border-t border-sand">
      <li class="flex gap-5 border-b border-sand py-6 md:gap-8">
        <p class="font-display text-4xl font-bold leading-none text-sand" aria-hidden="true">01</p>
        <div>
          <h3 class="text-xl">Connect your number</h3>
          <p class="mt-2 max-w-2xl text-muted">We link the WhatsApp line customers already use. No app for them to install.</p>
        </div>
      </li>
      <li class="flex gap-5 border-b border-sand py-6 md:gap-8">
        <p class="font-display text-4xl font-bold leading-none text-sand" aria-hidden="true">02</p>
        <div>
          <h3 class="text-xl">Tell it your prices</h3>
          <p class="mt-2 max-w-2xl text-muted">Share a price list, even a photo of a handwritten sheet. You can correct it any time.</p>
        </div>
      </li>
      <li class="flex gap-5 border-b border-sand py-6 md:gap-8">
        <p class="font-display text-4xl font-bold leading-none text-sand" aria-hidden="true">03</p>
        <div>
          <h3 class="text-xl">Approve the first few actions</h3>
          <p class="mt-2 max-w-2xl text-muted">Watch the log. Raise or lower limits. Undo for 24 hours.</p>
        </div>
      </li>
    </ol>
    <p class="mt-6"><a class="link-accent font-semibold" href="/how-it-works">See the full walkthrough</a></p>
  </section>

  <!-- Founding pilot -->
  <section class="border-y border-sand bg-surface py-16">
    <div class="mx-auto max-w-6xl px-4">
      <p class="eyebrow">Early access</p>
      <h2 class="mt-3 text-3xl md:text-4xl">Built with founding shops in Lagos</h2>
      <p class="mt-3 max-w-2xl text-muted">
        Kora Desk is live in a guided pilot. We onboard a few shops each week, sit with you through the first 14 days, and shape the product around what breaks.
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          foundingPerks.map((perk) => (
            <article class="rounded-3xl border border-sand bg-white p-6 transition-all duration-200 ease-out hover:-translate-y-1 hover:shadow-soft">
              <h3 class="text-xl">{perk.title}</h3>
              <p class="mt-2 text-muted">{perk.text}</p>
            </article>
          ))
        }
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/pilot" class="btn btn-primary">Join the pilot</a>
        <a href="/customers" class="btn btn-ghost">How the 14 days run</a>
      </div>
    </div>
  </section>

  <!-- Trust band -->
  <section class="bg-ink py-16 text-white">
    <div class="mx-auto max-w-6xl px-4">
      <p class="eyebrow eyebrow-bright">Trust</p>
      <h2 class="mt-3 max-w-2xl text-3xl">You <span class="underline decoration-accent-bright decoration-[3px] underline-offset-[6px]">approve money moves</span>. Everything is logged. You can undo.</h2>
      <p class="mt-4 max-w-2xl text-sand">
        The agent never pays a supplier, never issues a refund, and never writes off a debt without you. Full audit trail. 24-hour undo window.
      </p>
      <a href="/trust" class="btn btn-on-dark mt-6">Trust &amp; security</a>
    </div>
  </section>

  <!-- Pricing teaser -->
  <section class="mx-auto max-w-6xl px-4 pb-16">
    <h2 class="text-3xl">Simple prices in naira</h2>
    <p class="mt-3 max-w-2xl text-muted">No hidden charges. No “DM for price” games.</p>
    <p class="mt-2 text-muted">Starter from {naira(15000)} / month. Growth {naira(45000)}. 14-day pilot free.</p>
    <a class="btn btn-ghost mt-5" href="/pricing">See full pricing</a>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-4 pb-16">
    <h2 class="text-3xl">Questions owners ask</h2>
    <div class="mt-6">
      <Faq items={faqs} />
    </div>
  </section>

  <!-- Final CTA -->
  <div class="awning" aria-hidden="true"></div>
  <section class="bg-ink py-16 text-white">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <h2 class="text-4xl">Ready in two minutes</h2>
      <p class="mt-3 text-sand">Tell us your name, your shop, and your WhatsApp number. We set up the pilot with you.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/pilot" class="btn btn-light">Start free pilot</a>
        <a href={waLink("Hello, I want to start a Kora Desk pilot.", "home-cta")} class="btn btn-on-dark">Talk on WhatsApp</a>
        <a href="/demo" class="btn btn-on-dark">Book a 15-minute demo</a>
      </div>
    </div>
  </section>
</BaseLayout>
