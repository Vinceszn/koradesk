---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { agents } from "../../data/site";
import CommerceArtwork from "../../components/CommerceArtwork.astro";
import PageHero from "../../components/PageHero.astro";
---
<BaseLayout title="Your whole shop, working from the same page." description="One catalogue. One inventory ledger. Orders and payments connected across the ways you sell.">
<PageHero eyebrow="The Kora product plan" title="Your whole shop, working from the same page." lede="One catalogue. One inventory ledger. Orders and payments connected across the ways you sell." />
<section class="mx-auto max-w-6xl px-4 py-14"><div class="grid gap-4 md:grid-cols-2">
{agents.map(agent => <article class="rounded-3xl border border-sand bg-white p-6"><img src={`/brand/agent-${agent.slug}.png`} alt="" width="44" height="44" loading="lazy" /><h2 class="mt-4 text-2xl">{agent.name}</h2><p class="mt-3 text-muted">{agent.job}</p><p class="mt-3 text-sm text-muted">{agent.checkpoint}</p><a class="link-accent mt-4 inline-flex min-h-12 items-center text-sm font-semibold" href={agent.href}>Explore {agent.name} →</a></article>)}
</div></section>
<section class="mx-auto max-w-6xl px-4 py-14 commerce-art-grid"><CommerceArtwork kind="inventory" title="The inventory core comes first." description="Variants, reservations and stock movements connect every future channel." href="/product/stock" label="Explore inventory" /><CommerceArtwork kind="storefront" title="Your next shopfront can be online." description="A Kora-powered storefront is planned after the core workflow is proven." href="/product/storefront" label="Explore storefronts" /></section>
</BaseLayout>
