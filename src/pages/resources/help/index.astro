---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import { getCollection } from "astro:content";

const articles = (await getCollection("help")).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title="Help centre" description="Answers for pilots, WhatsApp numbers, approvals, and billing.">
  <PageHero eyebrow="Help" title="Find a short answer, then talk to a person if you need one" />
  <section class="mx-auto max-w-3xl px-4 py-14">
    <label class="block">
      <span class="font-semibold">Search this page</span>
      <input id="help-search" class="field mt-1.5" type="search" />
    </label>
    <ul class="mt-8 space-y-4">
      {
        articles.map((a) => (
          <li class="help-item rounded-3xl border border-sand bg-white p-6 transition-colors hover:border-ink" data-text={`${a.data.title} ${a.data.description} ${a.data.category}`.toLowerCase()}>
            <p class="text-sm font-semibold text-accent">{a.data.category}</p>
            <a href={`/resources/help/${a.id}`} class="mt-1 block text-2xl text-ink">
              {a.data.title}
            </a>
            <p class="mt-1 text-muted">{a.data.description}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById("help-search");
  input?.addEventListener("input", () => {
    const q = input.value.toLowerCase();
    document.querySelectorAll(".help-item").forEach((el) => {
      const hay = el.getAttribute("data-text") || "";
      el.style.display = hay.includes(q) ? "" : "none";
    });
  });
</script>
