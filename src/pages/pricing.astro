---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PricingTable from "../components/PricingTable.astro";
import RoiCalculator from "../components/RoiCalculator.astro";
---
<BaseLayout title="Proposed pricing" description="Explore Kora’s proposed pilot and store pricing. Plans are being validated; no subscription is sold here.">
<PageHero eyebrow="Pricing under review" title="Start small. Pay for what earns its place." lede="Proposed naira pricing for the founding pilot. Scope, access and final charges will be confirmed before billing." />
<section class="mx-auto max-w-6xl px-4 py-14"><PricingTable /><article class="mt-12 rounded-3xl border border-sand bg-white p-6"><h2 class="text-3xl">Orders, not an unlimited promise.</h2><p class="mt-2 text-muted">The proposed limits count orders created in a month. Payment processing, provider messaging fees and any future voice minutes are separate. Automatic WhatsApp delivery and storefront access are planned releases, not included live features today. Annual totals are an illustration only.</p></article><div class="mt-12"><RoiCalculator /></div></section>
</BaseLayout>
