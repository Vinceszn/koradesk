---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
---

<BaseLayout title="Retail & shops" description="WhatsApp order management for retail shops that still run on chats and notebooks.">
  <PageHero
    eyebrow="Retail"
    title="The counter is busy. The chats should not wait."
    lede="For provisions stores, corner shops, and salons with 5 to 30 staff."
  />
  <section class="mx-auto max-w-3xl px-4 py-14">
    <div class="prose-kora">
      <p>
        A typical Surulere shop takes orders while serving walk-ins. Someone copies chats into a book after close. That is the work Kora Desk takes first.
      </p>
      <ul>
        <li>Orders from voice notes and photos of lists</li>
        <li>Payment matching so credit is not guesswork</li>
        <li>A daily summary you can forward to family partners</li>
      </ul>
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn btn-primary" href="/pilot">Start a pilot</a>
      <a class="btn btn-ghost" href="/customers">See Okeke Provisions</a>
    </div>
  </section>
</BaseLayout>
