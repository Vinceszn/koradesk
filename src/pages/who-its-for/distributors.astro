---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
---

<BaseLayout title="Distributors" description="For wholesale distributors reconciling many small invoices and bank alerts.">
  <PageHero
    eyebrow="Distributors"
    title="Forty shops. One inbox. Fewer unmatched alerts."
    lede="Wholesale is a Payments and Stock problem as much as an Orders problem."
  />
  <section class="mx-auto max-w-3xl px-4 py-14">
    <div class="prose-kora">
      <p>
        If you sell to many small retailers, Growth is usually the right plan: three numbers, all four agents, and accountant sharing.
      </p>
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn btn-primary" href="/pilot">Start a pilot</a>
      <a class="btn btn-ghost" href="/pricing">See Growth pricing</a>
    </div>
  </section>
</BaseLayout>
