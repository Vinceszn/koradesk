---
import BaseLayout from "../../layouts/BaseLayout.astro";
const audiences = [
 ["Retail shops", "Counter sales and remote orders, with variants and one stock list.", "/who-its-for/retail"],
 ["Ecommerce and social sellers", "A checkout and DMs that share the same products and order records.", "/who-its-for/ecommerce"],
 ["Distributors", "Defined packs, stock receipts and a clear order-to-dispatch trail.", "/who-its-for/distributors"],
 ["Packaged food sellers", "Countable packs first; specialist stock rules need separate releases.", "/who-its-for/food"],
];
import PageHero from "../../components/PageHero.astro";
---
<BaseLayout title="Online, on the high street, or both." description="For businesses selling physical products and juggling stock, orders and payment checks.">
<PageHero eyebrow="The Kora product plan" title="Online, on the high street, or both." lede="For businesses selling physical products and juggling stock, orders and payment checks." />
<section class="mx-auto max-w-6xl px-4 py-14"><div class="grid gap-4 md:grid-cols-2">{audiences.map(([title,text,href]) => <a href={href} class="rounded-3xl border border-sand bg-white p-6 text-ink no-underline transition-colors hover:border-ink"><h2 class="text-2xl">{title}</h2><p class="mt-3 text-muted">{text}</p><span class="link-accent mt-4 inline-flex min-h-11 items-center text-sm">Explore this workflow →</span></a>)}</div></section>
</BaseLayout>
