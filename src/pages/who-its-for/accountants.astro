import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
---
<BaseLayout title="Useful records for the person reviewing the books." description="Operational exports for merchants and their accountants; a partner portal is a later possibility.">
<PageHero eyebrow="The Kora product plan" title="Useful records for the person reviewing the books." lede="Operational exports for merchants and their accountants; a partner portal is a later possibility." />
<section class="mx-auto max-w-3xl px-4 py-14 prose-kora">
<h2>Keep the references together</h2>
<p>Order IDs, payment references, receipt numbers and recorded stock movements should connect. That makes discrepancies easier to investigate.</p>
<h2>Review the assumptions</h2>
<p>Cash declarations, incomplete purchase costs and unrecorded expenses affect reporting. Gross-margin estimates are not audited profit or a tax return.</p>
<h2>No partner programme promised yet</h2>
<p>Multi-client dashboards, automatic tax filing and accountant subscriptions are outside the first MVP. We want feedback on the exports that would be useful first.</p>
<p><a href="/pilot" class="btn btn-primary">Explore the founding pilot</a></p>
</section>
</BaseLayout>
