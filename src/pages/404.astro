---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <section class="mx-auto max-w-lg px-4 py-16 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-4xl md:text-5xl">That page is not here</h1>
    <p class="mt-3 text-muted">It may have moved. Try home, pricing, or the help centre.</p>
    <p class="mt-6"><a class="btn btn-primary" href="/">Go home</a></p>
  </section>
</BaseLayout>
