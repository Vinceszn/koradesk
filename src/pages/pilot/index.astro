---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PilotForm from "../../components/PilotForm.astro";
---

<BaseLayout
  title="Start a free pilot"
  description="Try Kora Desk with your shop for 14 days. Guided setup, up to 100 conversations, and no card required."
>
  <section class="kora-container pilot-layout">
    <div class="pilot-intro">
      <p class="eyebrow">Your first 14 days are on us</p>
      <h1>
        Let’s give your
        <br />
        evenings back.
      </h1>
      <p>
        Tell us a little about your shop. A real person helps connect your
        number, check your prices, and review the first drafts with you.
      </p>
      <ul class="pilot-includes">
        <li>
          <span aria-hidden="true">01</span>A named person to help with setup
        </li>
        <li>
          <span aria-hidden="true">02</span>Up to 100 conversations during the
          pilot
        </li>
        <li>
          <span aria-hidden="true">03</span>You set the approval limits
        </li>
        <li>
          <span aria-hidden="true">04</span>No card required. Decide after 14
          days.
        </li>
      </ul>
      <p class="mt-6 text-sm">
        Already have questions?{" "}
        <a class="link-accent" href="/demo">
          Book a 15-minute walkthrough.
        </a>
      </p>
    </div>
    <div class="pilot-form-panel">
      <p>Start with your shop</p>
      <PilotForm />
    </div>
  </section>
</BaseLayout>
