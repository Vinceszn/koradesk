---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { site, waLink } from "../../data/site";
---

<BaseLayout title="Pilot request received" description="Your Kora Desk pilot request was received.">
  <PageHero
    eyebrow="Thank you"
    title="We have your number. A welcome chat is next."
    lede="Your request is saved. One tap sends it to us on WhatsApp, and a person confirms your number."
  />
  <section class="mx-auto max-w-lg px-4 py-14">
    <div id="summary" class="rounded-3xl border border-sand bg-white p-6"></div>
    <p class="mt-6">
      <a
        id="thanks-wa"
        class="btn btn-primary"
        data-whatsapp={site.whatsappE164}
        href={waLink("Hello, I just requested a pilot.", "thanks")}
      >
        Send on WhatsApp
      </a>
    </p>
    <p class="mt-3 text-sm text-muted">That tap puts you in the onboarding queue — we reply within one working day.</p>
  </section>
</BaseLayout>

<script>
  const raw = localStorage.getItem("kora-pilot");
  const box = document.getElementById("summary");
  const link = document.getElementById("thanks-wa");
  if (box && raw) {
    const d = JSON.parse(raw);
    box.innerHTML = `<p><strong>${d.name}</strong> · ${d.business}</p><p>${d.type}</p><p>${d.whatsapp}</p>`;
    if (link) {
      const number = link.getAttribute("data-whatsapp");
      const text = encodeURIComponent(`Hello, I just requested a pilot.\nName: ${d.name}\nBusiness: ${d.business} (${d.type})\nWhatsApp: ${d.whatsapp}\n\n[ref:thanks]`);
      link.setAttribute("href", `https://wa.me/${number}?text=${text}`);
    }
  } else if (box) {
    box.innerHTML = `We could not find a request on this device. <a class="link-accent" href="/pilot">Start a pilot request</a>.`;
  }
</script>
