---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { site, waLink } from "../../data/site";
---

<BaseLayout title="Review your pilot request" description="Review your Kora Desk pilot details, then send your request on WhatsApp.">
  <PageHero
    eyebrow="One more step"
    title="Ready when you are. Send your request."
    lede="Your draft is saved on this tab. Review it below, then send it to our team on WhatsApp."
  />
  <section class="mx-auto max-w-lg px-4 py-14">
    <div id="summary" class="rounded-3xl border border-sand bg-white p-6"></div>
    <p class="mt-6">
      <a
        id="thanks-wa"
        class="btn btn-primary"
        data-whatsapp={site.whatsappE164}
        href={waLink("Hello, I just requested a pilot.", "thanks")}
      >
        Send on WhatsApp
      </a>
    </p>
    <p class="mt-3 text-sm text-muted">That tap puts you in the onboarding queue — we reply within one working day.</p>
  </section>
</BaseLayout>

<script>
  const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
  let d = null;
  try {
    const raw = sessionStorage.getItem("kora-pilot");
    const parsed = raw ? JSON.parse(raw) : null;
    if (parsed && ["name", "business", "type", "whatsapp"].every(key => typeof parsed[key] === "string")) d = parsed;
  } catch {}
  const box = document.getElementById("summary");
  const link = document.getElementById("thanks-wa");
  if (box && d) {
    box.innerHTML = `<p><strong>${esc(d.name)}</strong> · ${esc(d.business)}</p><p>${esc(d.type)}</p><p>${esc(d.whatsapp)}</p>`;
    if (link) {
      const number = link.getAttribute("data-whatsapp");
      const text = encodeURIComponent(`Hello, I just requested a pilot.\nName: ${d.name}\nBusiness: ${d.business} (${d.type})\nWhatsApp: ${d.whatsapp}\n\n[ref:thanks]`);
      link.setAttribute("href", `https://wa.me/${number}?text=${text}`);
    }
  } else if (box) {
    link?.classList.add("hidden");
    box.innerHTML = `We could not find a draft on this tab. <a class="link-accent" href="/pilot">Start a pilot request</a>.`;
  }
</script>
