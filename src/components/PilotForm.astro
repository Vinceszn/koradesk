---
import { businessTypes } from "../data/site";
---

<form id="pilot-form" class="space-y-4" novalidate>
  <label class="block" for="pilot-name">
    <span class="text-sm font-semibold">Your name</span>
  </label>
  <input
    id="pilot-name"
    class="field"
    name="name"
    autocomplete="name"
    required
    aria-describedby="pilot-name-error"
  />
  <p id="pilot-name-error" class="error hidden text-sm text-clay">
    Please enter your name.
  </p>
  <label class="block" for="pilot-business">
    <span class="text-sm font-semibold">Business name</span>
  </label>
  <input
    id="pilot-business"
    class="field"
    name="business"
    autocomplete="organization"
    required
    aria-describedby="pilot-business-error"
  />
  <p id="pilot-business-error" class="error hidden text-sm text-clay">
    Please enter the business name.
  </p>
  <label class="block" for="pilot-type">
    <span class="text-sm font-semibold">Business type</span>
  </label>
  <select
    id="pilot-type"
    class="field"
    name="type"
    required
    aria-describedby="pilot-type-error"
  >
    <option value="">Choose one</option>
    {businessTypes.map((type) => (
      <option value={type}>{type}</option>
    ))}
  </select>
  <p id="pilot-type-error" class="error hidden text-sm text-clay">
    Please choose a type.
  </p>
  <label class="block" for="pilot-whatsapp">
    <span class="text-sm font-semibold">WhatsApp number</span>
  </label>
  <input
    id="pilot-whatsapp"
    class="field"
    type="tel"
    name="whatsapp"
    inputmode="tel"
    autocomplete="tel"
    placeholder="+234 801 234 5678"
    required
    aria-describedby="pilot-phone-hint pilot-whatsapp-error"
  />
  <p id="pilot-phone-hint" class="text-xs text-muted">
    Include your country code, for example +234.
  </p>
  <p id="pilot-whatsapp-error" class="error hidden text-sm text-clay">
    Enter a valid number with country code.
  </p>
  <label class="flex items-start gap-3 text-sm" for="pilot-consent">
    <input
      id="pilot-consent"
      class="mt-1 h-5 w-5 shrink-0"
      type="checkbox"
      name="consent"
      required
      aria-describedby="pilot-consent-error"
    />
    <span>
      I agree that Kora Desk may contact me on WhatsApp about the founding pilot, and I
      have read the{" "}
      <a class="link-accent" href="/legal/privacy">
        privacy notice
      </a>
      .
    </span>
  </label>
  <p id="pilot-consent-error" class="error hidden text-sm text-clay">
    Please tick the box to continue.
  </p>
  <p id="pilot-storage-error" class="form-error hidden" role="alert">
    This browser could not save your draft. Allow site storage, then try again.
  </p>
  <button type="submit" class="btn btn-accent w-full">
    Review my interest <span aria-hidden="true">↗</span>
  </button>
  <p class="text-xs text-muted">
    Next, review your details and prepare a message about your business. Nothing is sent
    from this form.
  </p>
  <noscript>
    <p class="form-error">
      Enable JavaScript to prepare your request, or{" "}
      <a href="/contact" class="link-accent">
        contact us directly
      </a>
      .
    </p>
  </noscript>
</form>
<script>
  const form = document.querySelector<HTMLFormElement>("#pilot-form");
  if (form) {
    const controls = {
      name: form.elements.namedItem("name") as HTMLInputElement,
      business: form.elements.namedItem("business") as HTMLInputElement,
      type: form.elements.namedItem("type") as HTMLSelectElement,
      whatsapp: form.elements.namedItem("whatsapp") as HTMLInputElement,
      consent: form.elements.namedItem("consent") as HTMLInputElement,
    };
    function invalid(
      input: HTMLInputElement | HTMLSelectElement,
      bad: boolean,
    ) {
      input.setAttribute("aria-invalid", String(bad));
      const error = document.getElementById(`${input.id}-error`);
      error?.classList.toggle("hidden", !bad);
    }
    // Clear stale feedback when the owner corrects a field; validate again on submit.
    Object.values(controls).forEach((input) =>
      input.addEventListener("input", () => invalid(input, false)),
    );
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const cleaned = controls.whatsapp.value.replace(/[\s()-]/g, "");
      const checks = [
        [controls.name, !controls.name.value.trim()],
        [controls.business, !controls.business.value.trim()],
        [controls.type, !controls.type.value],
        [controls.whatsapp, !/^\+[1-9]\d{7,14}$/.test(cleaned)],
        [controls.consent, !controls.consent.checked],
      ] as const;
      checks.forEach(([input, bad]) => invalid(input, bad));
      const first = checks.find(([, bad]) => bad);
      if (first) {
        first[0].focus();
        return;
      }
      const payload = JSON.stringify({
        name: controls.name.value.trim(),
        business: controls.business.value.trim(),
        type: controls.type.value,
        whatsapp: cleaned,
        at: new Date().toISOString(),
      });
      try {
        sessionStorage.setItem("kora-pilot", payload);
      } catch {
        document
          .getElementById("pilot-storage-error")
          ?.classList.remove("hidden");
        return;
      }
      window.location.assign("/pilot/thanks");
    });
  }
</script>
