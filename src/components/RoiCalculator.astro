<section class="rounded-3xl border border-sand bg-white p-6 md:p-8" aria-labelledby="roi-heading">
  <h2 id="roi-heading" class="text-2xl md:text-3xl">Hours and naira, not a promise</h2>
  <p class="mt-2 text-muted">
    Edit the numbers to match your shop. Results are estimates only. They are not a guarantee.
  </p>
  <form id="roi-form" class="mt-6 grid gap-4 md:grid-cols-2">
    <label class="block">
      <span class="text-sm font-semibold">Staff doing admin</span>
      <input class="field mt-1.5" type="number" name="staff" min="1" value="2" />
    </label>
    <label class="block">
      <span class="text-sm font-semibold">Hours / week on orders, payments, stock</span>
      <input class="field mt-1.5" type="number" name="hours" min="1" value="16" />
    </label>
    <label class="block">
      <span class="text-sm font-semibold">Average hourly cost (₦)</span>
      <input class="field mt-1.5" type="number" name="rate" min="100" step="100" value="2500" />
    </label>
    <label class="block">
      <span class="text-sm font-semibold">Monthly orders</span>
      <input class="field mt-1.5" type="number" name="orders" min="1" value="400" />
    </label>
    <label class="block md:col-span-2">
      <span class="text-sm font-semibold">Share of admin hours you think the assistant can take (editable)</span>
      <input class="field mt-1.5" type="number" name="share" min="10" max="90" value="50" />
    </label>
  </form>
  <div class="mt-6 grid gap-3 sm:grid-cols-2" id="roi-out"></div>
  <p class="mt-4 text-sm text-muted">
    Assumptions you can change: we apply your share percentage to weekly admin hours, multiply by 4.3 weeks, then compare to Growth at ₦45,000 / month. Starter is cheaper if you only need Orders and Payments.
  </p>
</section>

<script>
  const form = document.getElementById("roi-form");
  const out = document.getElementById("roi-out");
  const growth = 45000;

  function naira(n) {
    return new Intl.NumberFormat("en-NG", {
      style: "currency",
      currency: "NGN",
      maximumFractionDigits: 0,
    }).format(n);
  }

  function calc() {
    if (!form || !out) return;
    const data = new FormData(form);
    const hours = Number(data.get("hours")) || 0;
    const rate = Number(data.get("rate")) || 0;
    const share = (Number(data.get("share")) || 0) / 100;
    const hoursSaved = hours * share;
    const monthlyValue = hoursSaved * 4.3 * rate;
    const payback = monthlyValue > 0 ? growth / monthlyValue : 0;
    out.innerHTML = [
      ["Estimated hours saved / week", hoursSaved.toFixed(1)],
      ["Estimated naira value / month", naira(monthlyValue)],
      ["Growth plan cost", naira(growth)],
      ["Estimated payback", payback > 0 ? `${payback.toFixed(1)} months` : "—"],
    ]
      .map(
        ([k, v]) =>
          `<div class="rounded-xl border border-sand bg-surface p-4"><p class="text-sm text-muted">${k}</p><p class="mt-1 text-2xl font-semibold tracking-tight">${v}</p></div>`,
      )
      .join("");
  }

  form?.addEventListener("input", calc);
  calc();
</script>
