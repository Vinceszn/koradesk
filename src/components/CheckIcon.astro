---
interface Props {
  tone?: "ink" | "accent" | "plain";
}
const { tone = "ink" } = Astro.props;
const box =
  tone === "accent"
    ? "bg-accent text-white"
    : tone === "ink"
      ? "bg-ink text-white"
      : "text-leaf";
const shape =
  tone === "plain"
    ? "h-4 w-4 shrink-0"
    : "flex h-6 w-6 shrink-0 items-center justify-center rounded-md";
---

{tone === "plain" ? (
  <svg class={box + " " + shape} width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3 8.5l3.2 3.2L13 5" />
  </svg>
) : (
  <span class={box + " " + shape} aria-hidden="true">
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 8.5l3.2 3.2L13 5" />
    </svg>
  </span>
)}
