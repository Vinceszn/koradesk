<div
  id="cookie-banner"
  class="cookie-notice fixed inset-x-0 bottom-16 z-40 mx-auto hidden max-w-md rounded-2xl border border-sand bg-paper p-5 shadow-soft md:bottom-6"
  role="region"
  aria-labelledby="cookie-title"
>
  <p id="cookie-title" class="font-semibold">Browser preferences</p>
  <p class="mt-1 text-sm leading-relaxed text-muted">
    This preview stores preferences and form drafts in your browser. Analytics is not currently connected. See the
    <a class="link-accent" href="/legal/cookies">cookie notice</a>.
  </p>
  <div class="mt-4 flex flex-wrap gap-2">
    <button type="button" id="cookie-accept" class="btn btn-primary">
      Allow future analytics
    </button>
    <button type="button" id="cookie-reject" class="btn btn-ghost">
      Essential only
    </button>
  </div>
</div>

<script>
  const key = "kora-consent";
  const banner = document.getElementById("cookie-banner");
  try { if (!localStorage.getItem(key) && banner) banner.classList.remove("hidden"); }
  catch { banner?.classList.remove("hidden"); }
  function saveConsent(value: string) { try { localStorage.setItem(key, value); } catch {} banner?.classList.add("hidden"); }
  document.getElementById("cookie-accept")?.addEventListener("click", () => {
    saveConsent("analytics");
  });
  document.getElementById("cookie-reject")?.addEventListener("click", () => {
    saveConsent("essential");
  });
</script>
