---
import HeroDesk from "./HeroDesk.astro";
interface Props {
  anchorId?: string;
}
const { anchorId } = Astro.props;
---

<section id={anchorId} class="agent-section">
  <div class="kora-container home-section setup-section">
    <div>
      <p class="eyebrow">Try it for yourself</p>
      <h2>
        One chat.
        <br />
        Four things handled.
      </h2>
      <p class="setup-intro">
        Pick an agent and press play. Watch the messages arrive, then reply
        inside the chat when Kora asks for your say-so.
      </p>
      <p class="text-sm text-muted">
        Sample data only. No bank connection, no messages sent, no real money
        moves.
      </p>
    </div>
    <div class="phone-demo">
      <HeroDesk />
    </div>
  </div>
</section>
