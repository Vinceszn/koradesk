---
interface Props {
  anchorId?: string;
}
const { anchorId } = Astro.props;

const scenarios = [
  {
    id: "orders",
    label: "Orders",
    contact: "Chinedu Stores",
    initials: "CS",
    status: "online",
    steps: [
      { title: "Voice note in", caption: "A customer sends a voice note. The agent transcribes it instantly." },
      { title: "Order drafted", caption: "Prices come from your list. The customer confirms on WhatsApp." },
      { title: "Invoice sent", caption: "You still approve anything above your limit. Money never moves without you." },
    ],
  },
  {
    id: "payments",
    label: "Payments",
    contact: "Chinedu Stores",
    initials: "CS",
    status: "online",
    steps: [
      { title: "Bank alert in", caption: "A transfer lands with no name attached. The agent reads the alert." },
      { title: "Payment matched", caption: "Matched to the open invoice. Receipt sent — nothing left hunting." },
    ],
  },
  {
    id: "stock",
    label: "Stock",
    contact: "Shop Staff",
    initials: "SS",
    status: "3 online",
    steps: [
      { title: "Stock flag", caption: "Indomie drops to 4 cartons. The agent drafts a reorder." },
      { title: "You approve", caption: "One tap notifies the supplier. Counts update on delivery." },
    ],
  },
  {
    id: "books",
    label: "Books",
    contact: "My Accountant",
    initials: "MA",
    status: "online",
    steps: [
      { title: "Day summary", caption: "Sales, orders, and unpaid invoices — every evening at 6pm." },
      { title: "Accountant-ready", caption: "Simple P&L and tax-ready exports. Nothing filed without review." },
    ],
  },
];

const bars = Array.from({ length: 26 }, (_, i) => 6 + Math.round(12 * Math.abs(Math.sin(i * 1.35))));

const lines = [
  { item: "3 × 50kg rice", price: "₦168,000" },
  { item: "2 × Indomie carton", price: "₦24,500" },
  { item: "1 × 25L cooking oil", price: "₦41,000" },
];
const orderTotal = "₦233,500";

const stepsMeta = scenarios.map((s) => ({ id: s.id, steps: s.steps }));
const contactsMeta = scenarios.map((s) => ({ id: s.id, contact: s.contact, initials: s.initials, status: s.status }));
---

<section class="bg-surface" aria-labelledby="demo-heading" id={anchorId}>
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 lg:grid-cols-2">
    <div>
      <p class="eyebrow">Sample conversations</p>
      <h2 id="demo-heading" class="mt-3 text-3xl font-bold md:text-4xl">
        One number does all four jobs.
      </h2>
      <p class="mt-3 text-lg text-muted">
        Pick an agent and tap through a sample — no long talk, no sound, no autoplay.
      </p>
      <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label="Choose an agent demo">
        {
          scenarios.map((s, i) => (
            <button
              type="button"
              class="demo-scenario min-h-11 rounded-full border px-4 text-sm font-semibold transition-all duration-200 ease-out active:scale-[0.98]"
              class:list={i === 0 ? "border-ink bg-ink text-white" : "border-sand bg-white text-ink"}
              data-scenario={s.id}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              {s.label}
            </button>
          ))
        }
      </div>
      <ol class="mt-4 space-y-2.5" id="demo-steps">
        {
          scenarios[0].steps.map((step, i) => (
            <li>
              <button
                type="button"
                class="demo-step flex min-h-11 w-full items-start gap-3 px-4 py-3 text-left transition-all duration-200 ease-out active:scale-[0.98] rounded-2xl border border-sand bg-white"
                data-step={i}
                aria-pressed={i === 0 ? "true" : "false"}
              >
                <span
                  class="demo-num mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center text-xs font-bold rounded-full bg-ink text-white"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <span>
                  <strong class="block text-base font-semibold text-ink">{step.title}</strong>
                  <span class="text-sm text-muted">{step.caption}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ol>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <button type="button" id="demo-play" class="btn btn-primary disabled:opacity-50">Play this demo</button>
        <button type="button" id="demo-reset" class="btn btn-ghost">Reset</button>
        <p id="demo-status" class="w-full text-xs text-muted" aria-live="polite">Orders · Step 1 of 3</p>
      </div>
    </div>

    <div class="mx-auto w-full max-w-sm">
      <div class="relative flex flex-col rounded-[3rem] border border-white/10 bg-ink px-2 pb-3 pt-2 shadow-soft">
        <span class="absolute -left-[3px] top-24 h-20 w-[3px] rounded-full bg-neutral-700" aria-hidden="true"></span>
        <span class="absolute -right-[3px] top-32 h-14 w-[3px] rounded-full bg-neutral-700" aria-hidden="true"></span>
        <div class="relative flex h-[640px] flex-col overflow-hidden rounded-[2.5rem] bg-chat">
          <span class="absolute left-1/2 top-2.5 z-10 flex h-4 w-4 -translate-x-1/2 items-center justify-center rounded-full bg-ink" aria-hidden="true">
            <span class="h-1.5 w-1.5 rounded-full bg-neutral-700" aria-hidden="true"></span>
          </span>
          <div class="flex items-center justify-between px-6 pb-1 pt-3 text-xs font-semibold text-white" aria-hidden="true">
            <span>9:41</span>
            <span class="flex items-center gap-1.5">
              <svg width="16" height="12" viewBox="0 0 16 12" fill="currentColor"><rect x="0" y="7" width="3" height="5" rx="0.5"/><rect x="4.5" y="5" width="3" height="7" rx="0.5"/><rect x="9" y="2.5" width="3" height="9.5" rx="0.5"/><rect x="13" y="0" width="3" height="12" rx="0.5" opacity="0.4"/></svg>
              <svg width="16" height="12" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M1.5 4.5a10 10 0 0 1 13 0M4 7.2a6.4 6.4 0 0 1 8 0M6.6 9.8a2.8 2.8 0 0 1 2.8 0"/><circle cx="8" cy="11" r="0.9" fill="currentColor" stroke="none"/></svg>
              <svg width="24" height="12" viewBox="0 0 24 12" fill="none"><rect x="0.5" y="0.5" width="19" height="11" rx="2.5" stroke="currentColor" opacity="0.5"/><rect x="2.5" y="2.5" width="13" height="7" rx="1.5" fill="currentColor"/><path d="M22 4v4a2 2 0 0 0 0-4Z" fill="currentColor" opacity="0.5"/></svg>
            </span>
          </div>
          <div class="flex items-center gap-2 bg-accent px-2 py-2 text-white">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
            <span id="demo-avatar" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/20 text-sm font-bold" aria-hidden="true">CS</span>
            <span class="min-w-0 flex-1">
              <span id="demo-contact" class="block truncate text-sm font-semibold leading-tight">Chinedu Stores</span>
              <span id="demo-presence" class="block text-xs leading-tight text-white/80">online</span>
            </span>
            <span class="flex items-center gap-4 pr-1" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8 9.6a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2Z"/></svg>
            </span>
          </div>
          <div id="demo-chat" class="flex-1 space-y-2 overflow-y-auto overflow-x-hidden px-3 py-3" role="log" aria-live="polite" aria-label="Illustrative WhatsApp conversation">
            <p class="mx-auto w-fit rounded-lg border border-sand bg-bubble px-3 py-1 text-xs text-muted">Today</p>
            <p class="mx-auto w-fit rounded-lg border border-sand bg-bubble px-3 py-1 text-center text-xs leading-relaxed text-muted">
              Messages are end-to-end encrypted. This is a simulated demo — no real money moves.
            </p>
            <div id="demo-msgs" class="space-y-2"></div>
          </div>
          <div id="demo-chips" class="hidden flex-wrap gap-2 px-3 pb-2">
            <button
              type="button"
              id="demo-chip-yes"
              class="hidden min-h-11 items-center rounded-full border border-accent px-4 text-sm font-semibold text-accent transition-all duration-200 ease-out active:scale-[0.98]"
            >
              Reply YES
            </button>
            <button
              type="button"
              id="demo-chip-move"
              class="hidden min-h-11 items-center rounded-full border border-sand bg-bubble px-4 text-sm font-semibold text-ink transition-all duration-200 ease-out active:scale-[0.98]"
            >
              Move delivery to 10–12
            </button>
            <button
              type="button"
              id="demo-chip-approve"
              class="hidden min-h-11 items-center rounded-full border border-accent bg-accent px-4 text-sm font-semibold text-white transition-all duration-200 ease-out active:scale-[0.98]"
            >
              Approve reorder
            </button>
          </div>
          <div class="flex items-center gap-2 px-3 pb-4 pt-1" aria-hidden="true">
            <div class="flex min-h-11 flex-1 items-center rounded-full bg-bubble px-4 text-sm text-muted">Message</div>
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-accent text-white">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4"/></svg>
            </span>
          </div>
        </div>
      </div>
      <p class="mt-3 text-center text-xs text-muted">Mid-range Android · illustrative chats · silent</p>
    </div>
  </div>
</section>

<style is:global>
  @keyframes demo-rise {
    from { opacity: 0; transform: translateY(10px) scale(0.99); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .demo-enter { animation: demo-rise 0.28s ease-out; }
  @keyframes demo-blink {
    0%, 60%, 100% { opacity: 0.25; }
    30% { opacity: 1; }
  }
  .demo-dot { animation: demo-blink 1.1s infinite ease-in-out; }
  .demo-dot.d2 { animation-delay: 0.18s; }
  .demo-dot.d3 { animation-delay: 0.36s; }
  @media (prefers-reduced-motion: reduce) {
    .demo-enter, .demo-dot { animation: none; }
  }
</style>

<script define:vars={{ bars, lines, orderTotal, stepsMeta, contactsMeta }}>
  const msgs = document.getElementById("demo-msgs");
  const chat = document.getElementById("demo-chat");
  const stepsOl = document.getElementById("demo-steps");
  const tabBtns = Array.from(document.querySelectorAll(".demo-scenario"));
  const playBtn = document.getElementById("demo-play");
  const resetBtn = document.getElementById("demo-reset");
  const statusEl = document.getElementById("demo-status");
  const chipsEl = document.getElementById("demo-chips");
  const chipYes = document.getElementById("demo-chip-yes");
  const chipMove = document.getElementById("demo-chip-move");
  const chipApprove = document.getElementById("demo-chip-approve");
  const contactEl = document.getElementById("demo-contact");
  const avatarEl = document.getElementById("demo-avatar");
  const presenceEl = document.getElementById("demo-presence");

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let runId = 0;
  let timers = [];
  let scenario = "orders";
  let currentAct = 0;
  let playing = false;
  let moved = false;
  let confirmed = false;
  let approved = false;
  let clockMin = 8 * 60 + 9;

  function wait(ms) {
    return new Promise((resolve) => {
      if (reduced) { resolve(); return; }
      const t = window.setTimeout(resolve, ms);
      timers.push(t);
    });
  }

  function cancelPending() {
    runId += 1;
    timers.forEach((t) => window.clearTimeout(t));
    timers = [];
    document.querySelectorAll('[data-playing="1"]').forEach((el) => {
      const tid = Number(el.dataset.timer);
      if (tid) window.clearInterval(tid);
      el.dataset.playing = "0";
    });
  }

  function stamp() {
    clockMin += 2;
    const h = Math.floor(clockMin / 60);
    const m = String(clockMin % 60).padStart(2, "0");
    return `${h}:${m} AM`;
  }

  function scrollBottom() {
    if (chat) chat.scrollTop = chat.scrollHeight;
  }

  function metaRow(time, tick) {
    const row = document.createElement("div");
    row.className = "mt-1 flex items-center justify-end gap-1 text-xs text-muted";
    const t = document.createElement("span");
    t.textContent = time;
    row.appendChild(t);
    if (tick) {
      const s = document.createElement("span");
      s.textContent = "✓";
      s.setAttribute("aria-label", "sent");
      row.appendChild(s);
      tick.el = s;
    }
    return row;
  }

  function baseBubble(from, animate) {
    const wrap = document.createElement("div");
    wrap.className =
      from === "us"
        ? "ml-8 rounded-xl rounded-tr-sm bg-bubble-out px-3 py-2 text-sm leading-relaxed text-ink md:ml-10"
        : "mr-8 rounded-xl rounded-tl-sm bg-bubble px-3 py-2 text-sm leading-relaxed text-ink md:mr-10";
    if (animate && !reduced) wrap.classList.add("demo-enter");
    return wrap;
  }

  function upgradeTicks(tick, id) {
    if (!tick.el || id !== runId) return;
    wait(700).then(() => {
      if (id !== runId || !tick.el) return;
      tick.el.textContent = "✓✓";
      tick.el.setAttribute("aria-label", "delivered");
      return wait(900);
    }).then(() => {
      if (id !== runId || !tick.el) return;
      tick.el.classList.add("text-tick");
      tick.el.setAttribute("aria-label", "read");
    });
  }

  function addText(from, text, animate, withTicks) {
    if (!msgs) return;
    const b = baseBubble(from, animate);
    const p = document.createElement("p");
    p.textContent = text;
    b.appendChild(p);
    const tick = {};
    b.appendChild(metaRow(stamp(), withTicks ? tick : null));
    msgs.appendChild(b);
    scrollBottom();
    if (withTicks) upgradeTicks(tick, runId);
  }

  function addVoice(animate) {
    if (!msgs) return;
    const b = baseBubble("them", animate);
    const row = document.createElement("div");
    row.className = "flex items-center gap-2";
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-accent text-white transition-all duration-200 ease-out active:scale-[0.98]";
    btn.setAttribute("aria-label", "Play voice note, 12 seconds");
    btn.dataset.voiceToggle = "0";
    btn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>';
    const wave = document.createElement("div");
    wave.className = "flex min-w-0 flex-1 items-center gap-[3px]";
    wave.setAttribute("aria-hidden", "true");
    wave.dataset.voiceBars = "1";
    bars.forEach((h) => {
      const bar = document.createElement("span");
      bar.className = "min-w-[2px] max-w-1 flex-1 rounded-full bg-sand";
      bar.style.height = `${h}px`;
      wave.appendChild(bar);
    });
    const dur = document.createElement("span");
    dur.className = "shrink-0 text-xs text-muted";
    dur.dataset.voiceTime = "1";
    dur.textContent = "0:12";
    row.append(btn, wave, dur);
    b.appendChild(row);
    const cap = document.createElement("p");
    cap.className = "mt-1 text-xs text-muted";
    cap.textContent = "Voice note · transcribed by the Orders agent";
    b.appendChild(cap);
    b.appendChild(metaRow(stamp(), null));
    msgs.appendChild(b);
    scrollBottom();
  }

  function addOrder(animate) {
    if (!msgs) return;
    const b = baseBubble("us", animate);
    const head = document.createElement("p");
    head.className = "text-sm font-bold tracking-tight text-ink";
    head.textContent = "Order draft · Chinedu Stores";
    b.appendChild(head);
    const list = document.createElement("div");
    list.className = "mt-2 space-y-1 border-t border-ink/10 pt-2";
    lines.forEach((l) => {
      const r = document.createElement("div");
      r.className = "flex items-center justify-between gap-4 text-sm";
      const k = document.createElement("span");
      k.textContent = `• ${l.item}`;
      const v = document.createElement("span");
      v.className = "font-semibold";
      v.textContent = l.price;
      r.append(k, v);
      list.appendChild(r);
    });
    b.appendChild(list);
    const total = document.createElement("div");
    total.className = "mt-2 flex items-center justify-between gap-4 border-t border-ink/10 pt-2 text-sm font-bold tracking-tight";
    const tk = document.createElement("span");
    tk.textContent = "Total";
    const tv = document.createElement("span");
    tv.textContent = orderTotal;
    total.append(tk, tv);
    b.appendChild(total);
    const foot = document.createElement("p");
    foot.className = "mt-2 text-sm";
    foot.textContent = "Delivery tomorrow 7–9am. Reply YES to confirm.";
    b.appendChild(foot);
    const tick = {};
    b.appendChild(metaRow(stamp(), tick));
    msgs.appendChild(b);
    scrollBottom();
    upgradeTicks(tick, runId);
  }

  function addInvoice(animate) {
    if (!msgs) return;
    const doc = baseBubble("us", animate);
    const row = document.createElement("div");
    row.className = "flex items-center gap-3";
    const icon = document.createElement("span");
    icon.className = "flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-surface text-xs font-bold text-clay";
    icon.textContent = "PDF";
    const meta = document.createElement("span");
    meta.className = "min-w-0 flex-1";
    const name = document.createElement("span");
    name.className = "block truncate text-sm font-semibold";
    name.textContent = "Invoice KD-1842.pdf";
    const sub = document.createElement("span");
    sub.className = "block text-xs text-muted";
    sub.textContent = "1 page · tax-ready";
    meta.append(name, sub);
    row.append(icon, meta);
    doc.appendChild(row);
    const tick = {};
    doc.appendChild(metaRow(stamp(), tick));
    msgs.appendChild(doc);
    upgradeTicks(tick, runId);
    const note = baseBubble("us", animate);
    const p = document.createElement("p");
    p.textContent = "Transfer to GTBank 0123456789, Kora Desk Merchants. I will match the alert and release the delivery note.";
    note.appendChild(p);
    const tick2 = {};
    note.appendChild(metaRow(stamp(), tick2));
    msgs.appendChild(note);
    scrollBottom();
    upgradeTicks(tick2, runId);
  }

  function addAlert(animate) {
    if (!msgs) return;
    const b = baseBubble("them", animate);
    const label = document.createElement("p");
    label.className = "text-xs font-semibold text-muted";
    label.textContent = "BANK ALERT · GTB";
    b.appendChild(label);
    const p = document.createElement("p");
    p.className = "mt-1";
    p.textContent = "₦168,000 credited to 0123456789 KD-MERCHANTS. No sender name attached.";
    b.appendChild(p);
    b.appendChild(metaRow(stamp(), null));
    msgs.appendChild(b);
    scrollBottom();
  }

  function addMatched(animate) {
    addText("us", "Matched: ₦168,000 → Invoice KD-1842 (Chinedu Stores). Receipt sent — nothing left unmatched tonight.", animate, true);
  }

  function addStockCard(animate) {
    if (!msgs) return;
    const b = baseBubble("us", animate);
    const head = document.createElement("p");
    head.className = "text-sm font-bold tracking-tight text-ink";
    head.textContent = "Stock flag · Indomie";
    b.appendChild(head);
    const list = document.createElement("div");
    list.className = "mt-2 space-y-1 border-t border-ink/10 pt-2 text-sm";
    [
      ["On hand", "4 cartons"],
      ["Burn rate", "~3 / day"],
      ["Draft", "Reorder 10 from supplier"],
    ].forEach(([k, v]) => {
      const r = document.createElement("div");
      r.className = "flex items-center justify-between gap-4";
      const kk = document.createElement("span");
      kk.className = "text-muted";
      kk.textContent = k;
      const vv = document.createElement("span");
      vv.className = "font-semibold";
      vv.textContent = v;
      r.append(kk, vv);
      list.appendChild(r);
    });
    b.appendChild(list);
    const foot = document.createElement("p");
    foot.className = "mt-2 text-sm";
    foot.textContent = "Tap Approve reorder below and I notify the supplier.";
    b.appendChild(foot);
    const tick = {};
    b.appendChild(metaRow(stamp(), tick));
    msgs.appendChild(b);
    scrollBottom();
    upgradeTicks(tick, runId);
  }

  function addBooksCard(animate) {
    if (!msgs) return;
    const b = baseBubble("us", animate);
    const head = document.createElement("p");
    head.className = "text-sm font-bold tracking-tight text-ink";
    head.textContent = "Today · 6:02 PM";
    b.appendChild(head);
    const list = document.createElement("div");
    list.className = "mt-2 space-y-1 border-t border-ink/10 pt-2 text-sm";
    [
      ["Sales", "₦1,240,000"],
      ["Orders", "34 confirmed"],
      ["Unpaid", "2 invoices · ₦86,500"],
    ].forEach(([k, v]) => {
      const r = document.createElement("div");
      r.className = "flex items-center justify-between gap-4";
      const kk = document.createElement("span");
      kk.className = "text-muted";
      kk.textContent = k;
      const vv = document.createElement("span");
      vv.className = "font-semibold";
      vv.textContent = v;
      r.append(kk, vv);
      list.appendChild(r);
    });
    b.appendChild(list);
    const foot = document.createElement("p");
    foot.className = "mt-2 text-sm";
    foot.textContent = "Daily summary saved to Books.";
    b.appendChild(foot);
    const tick = {};
    b.appendChild(metaRow(stamp(), tick));
    msgs.appendChild(b);
    scrollBottom();
    upgradeTicks(tick, runId);
  }

  async function showTyping(id) {
    if (!msgs || id !== runId) return;
    const b = baseBubble("us", !reduced);
    b.classList.add("mr-8", "md:mr-10", "w-fit");
    const dots = document.createElement("span");
    dots.className = "flex items-center gap-1 py-1";
    dots.innerHTML = '<span class="demo-dot inline-block h-2 w-2 rounded-full bg-muted"></span><span class="demo-dot d2 inline-block h-2 w-2 rounded-full bg-muted"></span><span class="demo-dot d3 inline-block h-2 w-2 rounded-full bg-muted"></span>';
    const sr = document.createElement("span");
    sr.className = "sr-only";
    sr.textContent = "Kora Desk is typing";
    b.append(dots, sr);
    msgs.appendChild(b);
    scrollBottom();
    await wait(1200);
    if (id === runId && b.parentNode) b.remove();
  }

  function setContact(id) {
    const c = contactsMeta.find((x) => x.id === id);
    if (!c) return;
    if (contactEl) contactEl.textContent = c.contact;
    if (avatarEl) avatarEl.textContent = c.initials;
    if (presenceEl) presenceEl.textContent = c.status;
  }

  function stepsFor(id) {
    const s = stepsMeta.find((x) => x.id === id);
    return s ? s.steps : [];
  }

  function labelFor(id) {
    const map = { orders: "Orders", payments: "Payments", stock: "Stock", books: "Books" };
    return map[id] || id;
  }

  function paintTabs() {
    tabBtns.forEach((btn) => {
      const on = btn.dataset.scenario === scenario;
      btn.setAttribute("aria-pressed", String(on));
      btn.classList.toggle("bg-ink", on);
      btn.classList.toggle("text-white", on);
      btn.classList.toggle("border-ink", on);
      btn.classList.toggle("bg-white", !on);
      btn.classList.toggle("text-ink", !on);
      btn.classList.toggle("border-sand", !on);
    });
  }

  function paintSteps() {
    if (!stepsOl) return;
    const steps = stepsFor(scenario);
    stepsOl.innerHTML = "";
    steps.forEach((step, i) => {
      const li = document.createElement("li");
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "demo-step flex min-h-11 w-full items-start gap-3 px-4 py-3 text-left transition-all duration-200 ease-out active:scale-[0.98] rounded-2xl border bg-white";
      btn.classList.add(i === currentAct ? "border-ink" : "border-sand");
      btn.dataset.step = String(i);
      btn.setAttribute("aria-pressed", String(i === currentAct));
      const num = document.createElement("span");
      num.className = "mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center text-xs font-bold rounded-full text-white";
      num.classList.add(i < currentAct ? "bg-accent" : "bg-ink");
      num.setAttribute("aria-hidden", "true");
      num.textContent = i < currentAct ? "✓" : String(i + 1);
      const wrap = document.createElement("span");
      const title = document.createElement("strong");
      title.className = "block text-base font-semibold text-ink";
      title.textContent = step.title;
      const cap = document.createElement("span");
      cap.className = "text-sm text-muted";
      cap.textContent = step.caption;
      wrap.append(title, cap);
      btn.append(num, wrap);
      li.appendChild(btn);
      stepsOl.appendChild(li);
    });
    const n = steps.length;
    let hint = "";
    if (scenario === "orders" && currentAct === 1 && !confirmed) hint = " — try Reply YES in the phone";
    if (scenario === "stock" && currentAct === 0 && !approved) hint = " — tap Approve reorder in the phone";
    if (statusEl) statusEl.textContent = playing
      ? `Playing… ${labelFor(scenario)} · step ${currentAct + 1} of ${n}`
      : `${labelFor(scenario)} · Step ${currentAct + 1} of ${n}${hint}`;
    paintChips();
  }

  function showChip(el, on, inlineFlex) {
    if (!el) return;
    el.classList.toggle("hidden", !on);
    el.classList.toggle(inlineFlex ? "inline-flex" : "flex", on);
  }

  function paintChips() {
    const awaitingYes = scenario === "orders" && currentAct === 1 && !confirmed;
    const awaitingApprove = scenario === "stock" && currentAct === 0 && !approved;
    const open = awaitingYes || awaitingApprove;
    if (chipsEl) {
      chipsEl.classList.toggle("hidden", !open);
      chipsEl.classList.toggle("flex", open);
    }
    showChip(chipYes, awaitingYes, true);
    showChip(chipMove, awaitingYes, true);
    showChip(chipApprove, awaitingApprove, true);
  }

  function clearChat() {
    if (msgs) msgs.innerHTML = "";
    clockMin = 8 * 60 + 9;
    moved = false;
    confirmed = false;
    approved = false;
  }

  async function showScenario(sc, act, animate) {
    const id = runId;
    scenario = sc;
    currentAct = act;
    setContact(sc);
    if (sc === "orders") {
      if (animate) {
        if (act >= 1) addVoice(false);
        if (act >= 2) {
          addOrder(false);
          if (confirmed) addText("them", "YES", false, false);
        }
        if (act === 0) addVoice(true);
        if (act === 1) {
          await showTyping(id);
          if (id !== runId) return;
          addOrder(true);
        }
        if (act >= 2) {
          await wait(500);
          if (id !== runId) return;
          if (!confirmed) addText("them", "YES", true, false);
          await showTyping(id);
          if (id !== runId) return;
          addInvoice(true);
        }
      } else {
        addVoice(false);
        if (act >= 1) addOrder(false);
        if (act >= 2) {
          addText("them", "YES", false, false);
          addInvoice(false);
        }
      }
    }
    if (sc === "payments") {
      if (act === 0) addAlert(animate);
      if (act >= 1) {
        if (animate) {
          if (msgs && !msgs.children.length) addAlert(false);
          await showTyping(id);
          if (id !== runId) return;
        } else {
          addAlert(false);
        }
        addMatched(animate);
      }
    }
    if (sc === "stock") {
      if (act === 0) addStockCard(animate);
      if (act >= 1) {
        if (animate) {
          if (msgs && !msgs.children.length) addStockCard(false);
          await wait(400);
          if (id !== runId) return;
          if (!approved) addText("them", "Approve reorder", true, false);
          await showTyping(id);
          if (id !== runId) return;
          addText("us", "Approved — supplier notified, ETA Thursday. Counts update when stock lands.", true, true);
        } else {
          addStockCard(false);
          addText("them", "Approve reorder", false, false);
          addText("us", "Approved — supplier notified, ETA Thursday. Counts update when stock lands.", false, true);
        }
      }
    }
    if (sc === "books") {
      if (act === 0) addBooksCard(animate);
      if (act >= 1) {
        if (animate) {
          if (msgs && !msgs.children.length) addBooksCard(false);
          await showTyping(id);
          if (id !== runId) return;
        } else {
          addBooksCard(false);
        }
        addText("us", "P&L and VAT summary exported for October. Nothing is filed until your accountant reviews.", animate, true);
      }
    }
    paintTabs();
    paintSteps();
  }

  function switchScenario(sc) {
    if (playing || sc === scenario) return;
    cancelPending();
    clearChat();
    showScenario(sc, 0, false);
    scrollBottom();
  }

  function jumpTo(i) {
    if (playing) return;
    cancelPending();
    clearChat();
    showScenario(scenario, i, false);
    scrollBottom();
  }

  async function playScenario() {
    if (playing) return;
    playing = true;
    if (playBtn) playBtn.setAttribute("disabled", "true");
    cancelPending();
    clearChat();
    const maxAct = stepsFor(scenario).length - 1;
    for (let a = 0; a <= maxAct; a += 1) {
      clearChat();
      await showScenario(scenario, a, true);
      if (!playing) break;
      await wait(a === 0 ? 1500 : 2000);
      if (!playing) break;
    }
    playing = false;
    if (playBtn) playBtn.removeAttribute("disabled");
    paintTabs();
    paintSteps();
  }

  tabBtns.forEach((btn) => {
    btn.addEventListener("click", () => switchScenario(btn.dataset.scenario));
  });

  stepsOl?.addEventListener("click", (e) => {
    const t = e.target;
    const btn = t.closest ? t.closest(".demo-step") : null;
    if (!btn) return;
    jumpTo(Number(btn.dataset.step));
  });

  playBtn?.addEventListener("click", playScenario);

  resetBtn?.addEventListener("click", () => {
    if (playing) return;
    cancelPending();
    clearChat();
    showScenario(scenario, 0, false);
    scrollBottom();
  });

  chipYes?.addEventListener("click", () => {
    if (playing || scenario !== "orders" || currentAct !== 1 || confirmed) return;
    confirmed = true;
    cancelPending();
    const id = runId;
    currentAct = 2;
    addText("them", "YES", true, false);
    showTyping(id).then(() => {
      if (id !== runId) return;
      addInvoice(true);
      paintTabs();
      paintSteps();
    });
    paintTabs();
    paintSteps();
  });

  chipMove?.addEventListener("click", () => {
    if (playing || scenario !== "orders" || currentAct !== 1 || moved) return;
    moved = true;
    addText("them", "Can you move delivery to 10–12?", true, false);
    const id = runId;
    showTyping(id).then(() => {
      if (id !== runId) return;
      addText("us", "Done — delivery moved to 10–12am. Reply YES to confirm.", true, true);
      paintTabs();
      paintSteps();
    });
    paintTabs();
    paintSteps();
  });

  chipApprove?.addEventListener("click", () => {
    if (playing || scenario !== "stock" || approved) return;
    approved = true;
    cancelPending();
    const id = runId;
    currentAct = 1;
    addText("them", "Approve reorder", true, false);
    showTyping(id).then(() => {
      if (id !== runId) return;
      addText("us", "Approved — supplier notified, ETA Thursday. Counts update when stock lands.", true, true);
      paintTabs();
      paintSteps();
    });
    paintTabs();
    paintSteps();
  });

  chat?.addEventListener("click", (e) => {
    const target = e.target;
    const btn = target.closest ? target.closest("[data-voice-toggle]") : null;
    if (!btn || reduced) return;
    const bubble = btn.closest("div.ml-10, div.mr-10") || (btn.parentElement ? btn.parentElement.parentElement : null);
    if (!bubble) return;
    const barEls = Array.from(bubble.querySelectorAll("[data-voice-bars] span"));
    const timeEl = bubble.querySelector("[data-voice-time]");
    const total = barEls.length || bars.length;

    if (btn.dataset.playing === "1") {
      btn.dataset.playing = "0";
      const tid = Number(btn.dataset.timer);
      if (tid) window.clearInterval(tid);
      btn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>';
      btn.setAttribute("aria-label", "Play voice note, 12 seconds");
      return;
    }
    btn.dataset.playing = "1";
    btn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>';
    btn.setAttribute("aria-label", "Pause voice note");
    let n = Number(btn.dataset.progress || "0");
    const timer = window.setInterval(() => {
      n += 1;
      btn.dataset.progress = String(n);
      barEls.forEach((bar, bi) => {
        bar.classList.toggle("bg-accent", bi < n);
        bar.classList.toggle("bg-sand", bi >= n);
      });
      const secs = Math.min(12, Math.round((n / total) * 12));
      if (timeEl) timeEl.textContent = `0:${String(secs).padStart(2, "0")}`;
      if (n >= total) {
        window.clearInterval(timer);
        btn.dataset.playing = "0";
        btn.dataset.progress = "0";
        btn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>';
        btn.setAttribute("aria-label", "Replay voice note, 12 seconds");
        window.setTimeout(() => {
          barEls.forEach((bar) => {
            bar.classList.remove("bg-accent");
            bar.classList.add("bg-sand");
          });
          if (timeEl) timeEl.textContent = "0:12";
        }, 900);
      }
    }, 450);
    btn.dataset.timer = String(timer);
  });

  scenario = "orders";
  currentAct = 0;
  addVoice(false);
  paintTabs();
  paintSteps();
</script>
